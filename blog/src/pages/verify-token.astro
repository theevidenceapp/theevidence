---
import { ClientRouter } from "astro:transitions";
import TokenCapture from "../components/token/TokenCapture";
import "../styles/globals.css";

export const prerender = false;
const token = Astro.url.searchParams.get("token");
---

<html lang="en">
  <head>
    <ClientRouter />
  </head>
  <body>
    <div
      class="fixed inset-0 z-[99999] flex items-center justify-center bg-white"
    >
      <div
        class="h-10 w-10 animate-spin rounded-full border-4 border-gray-300 border-t-black"
      >
      </div>
    </div>
    <TokenCapture client:load />
  </body>
</html>
