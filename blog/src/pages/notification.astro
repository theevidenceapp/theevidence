---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

const THE_EVIDENCE_LOGO = "https://pub-d65f9d792dba44cfb4b36fdd1925ed72.r2.dev/theevidence.png";

let notifications = [];

try {
  const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
  const res = await fetch(`${apiUrl}/api/notifications`);
  if (res.ok) notifications = await res.json();
} catch (e) {
  // Silent fallback
}

const unreadNotifications = [
  {
    id: 1,
    title: "Your research was submitted for review",
    description: "“The Impact of Urban Green Spaces” was successfully submitted.",
    time: "2 min ago",
    type: "research"
  },
  {
    id: 2,
    title: "Your research was published",
    description: "“The Future of Sustainable Architecture” is now live.",
    time: "2 hours ago",
    type: "research"
  },
  {
    id: 3,
    title: "Your research was submitted for rejected",
    description: "“The Impact of Urban Green Spaces” was rejected.",
    time: "Yesterday",
    type: "research"
  }
];

const pastNotifications = [
  {
    id: 4,
    title: "Your research was submitted for review",
    description: "“The Impact of Urban Green Spaces” was successfully submitted.",
    time: "Aug 20, 2026",
    type: "research"
  },
  {
    id: 5,
    title: "Your findings are ready for publication",
    description: "“The Role of Data Analytics in Business” is set for release.",
    time: "Nov 5, 2026",
    type: "research"
  },
  {
    id: 6,
    title: "Signed in successfully",
    description: "You signed in with Google.",
    time: "Aug 18, 2026",
    type: "account"
  },
  {
    id: 7,
    title: "Welcome to The Evidence",
    description: "Your researcher account is ready. Start writing your first research.",
    time: "Aug 17, 2026",
    type: "account"
  }
];

const extraPastNotifications = [
  {
    id: 8,
    title: "Security setting updated",
    description: "Two-factor authentication was enabled.",
    time: "Aug 10, 2026",
    type: "account"
  }
];
---

<!doctype html>
<html lang="en" class="bg-[#f3f3f5]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <ClientRouter />
    <title>The Evidence - Notification</title>
    <style>
      html, body {
        background-color: #f3f3f5 !important;
      }
      .no-scroll::-webkit-scrollbar {
        display: none;
      }
      .no-scroll {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-[#f3f3f5] text-[#111] antialiased h-screen w-screen overflow-hidden flex flex-col m-0 p-0 font-sans select-none relative">
    
    <!-- DESKTOP / TABLET HOVER DRAWER SIDEBAR -->
    <aside
      class="hidden md:flex group absolute top-0 left-0 bottom-0 z-50 w-[74px] hover:w-[220px] bg-[#f3f3f5] hover:shadow-[10px_0_30px_rgba(0,0,0,0.06)] transition-all duration-300 ease-in-out flex-col items-start px-3.5 py-6 shrink-0"
    >
      <!-- Big Logo Inside Drawer -->
      <a href="/" class="flex items-center h-[56px] px-1 mb-6 overflow-hidden shrink-0 w-full" title="The Evidence">
        <img
          src={THE_EVIDENCE_LOGO}
          alt="The Evidence"
          class="h-12 w-auto max-w-none object-contain shrink-0"
        />
      </a>

      <!-- Navigation Items -->
      <nav class="flex flex-col gap-3.5 w-full">
        
        <!-- 1. Discover -->
        <a
          href="/discover"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Discover"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
              <path d="M4.31802 19.682C3 18.364 3 16.2426 3 12C3 7.75736 3 5.63604 4.31802 4.31802C5.63604 3 7.75736 3 12 3C16.2426 3 18.364 3 19.682 4.31802C21 5.63604 21 7.75736 21 12C21 16.2426 21 18.364 19.682 19.682C18.364 21 16.2426 21 12 21C7.75736 21 5.63604 21 4.31802 19.682Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 14L9.79289 11.2071C10.1834 10.8166 10.8166 10.8166 11.2071 11.2071L12.7929 12.7929C13.1834 13.1834 13.8166 13.1834 14.2071 12.7929L17 10" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Discover
          </span>
        </a>

        <!-- 2. Desk -->
        <a
          href="/desk"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Desk"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
              <path d="M10.5502 3C6.69782 3.00694 4.6805 3.10152 3.39128 4.39073C2 5.78202 2 8.02125 2 12.4997C2 16.9782 2 19.2174 3.39128 20.6087C4.78257 22 7.0218 22 11.5003 22C15.9787 22 18.218 22 19.6093 20.6087C20.8985 19.3195 20.9931 17.3022 21 13.4498" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M11.0557 13C10.3323 3.86635 16.8024 1.27554 21.9806 2.16439C22.1897 5.19136 20.7086 6.32482 17.888 6.84825C18.4327 7.41736 19.3951 8.13354 19.2913 9.02879C19.2174 9.66586 18.7847 9.97843 17.9195 10.6036C16.0232 11.9736 13.8265 12.8375 11.0557 13Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 17C11 11.5 12.9604 9.63636 15 8" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Desk
          </span>
        </a>

        <!-- 3. Notification (Active Blue Circle/Pill) -->
        <a
          href="/notification"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full bg-[#e8f0fe] text-[#0d0d0c] transition-all duration-300 overflow-hidden"
          title="Notification"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
              <path d="M15.5 18C15.5 19.933 13.933 21.5 12 21.5C10.067 21.5 8.5 19.933 8.5 18" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19.2311 18H4.76887C3.79195 18 3 17.208 3 16.2311C3 15.762 3.18636 15.3121 3.51809 14.9803L4.12132 14.3771C4.68393 13.8145 5 13.0514 5 12.2558V9.5C5 5.63401 8.13401 2.5 12 2.5C15.866 2.5 19 5.634 19 9.5V12.2558C19 13.0514 19.3161 13.8145 19.8787 14.3771L20.4819 14.9803C20.8136 15.3121 21 15.762 21 16.2311C21 17.208 20.208 18 19.2311 18Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 9C21.2088 9 23 7.2088 23 5C23 2.7904 21.2088 1 19 1C16.7912 1 15 2.7904 15 5C15 7.2088 16.7912 9 19 9Z" fill="#2563EB"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Notification
          </span>
        </a>

        <!-- 4. Account -->
        <a
          href="/account"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Account"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
              <path d="M18.4984 19.1511C17.3377 17.4018 15.2947 16.2009 12.9313 16.0569L11.9984 16C11.6652 16.0083 11.3547 16.0194 11.0617 16.0325C8.71722 16.1376 6.66598 17.3796 5.5 19.1511" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14.9961 10C14.9961 11.6569 13.6529 13 11.9961 13C10.3392 13 8.99609 11.6569 8.99609 10C8.99609 8.34315 10.3392 7 11.9961 7C13.6529 7 14.9961 8.34315 14.9961 10Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Account
          </span>
        </a>

      </nav>
    </aside>

    <!-- Top Header -->
    <header class="h-[68px] sm:h-[76px] px-4 md:pl-[90px] md:pr-8 flex items-center justify-between shrink-0 z-20 bg-[#f3f3f5]">
      
      <!-- Mobile Logo + Route Label -->
      <div class="flex items-center gap-3 sm:gap-4 shrink-0 mr-2 sm:mr-4">
        <a href="/" class="flex md:hidden items-center" title="The Evidence">
          <img src={THE_EVIDENCE_LOGO} alt="The Evidence" class="h-8 w-auto object-contain" />
        </a>
        <span class="text-[16px] sm:text-[17px] font-normal text-[#2b2b2b] tracking-tight">Notification</span>
      </div>

      <!-- Center Search Bar -->
      <div class="flex-1 max-w-[560px]">
        <div class="relative w-full">
          <svg class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-[#666]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="notification-search"
            placeholder="Search notifications"
            class="w-full pl-11 pr-4 py-2 sm:py-2.5 text-[12.5px] sm:text-[13px] bg-white text-[#111] placeholder-[#777] rounded-full border-none shadow-[0_1px_3px_rgba(0,0,0,0.02)] focus:outline-none focus:ring-1 focus:ring-blue-500"
          />
        </div>
      </div>

      <div class="hidden lg:block w-[180px]"></div>
    </header>

    <!-- Main Viewport Layout -->
    <div class="flex-1 flex px-4 sm:px-6 md:pl-[90px] md:pr-8 pb-20 md:pb-6 pt-1 gap-6 overflow-hidden max-w-[1280px] w-full mx-auto">
      
      <!-- Center Main Content Feed -->
      <main class="flex-1 h-full overflow-y-auto no-scroll flex flex-col items-center">
        
        <!-- Filter Tabs -->
        <div class="sticky top-0 z-10 pb-3 pt-0.5 bg-[#f3f3f5]/95 backdrop-blur-sm flex items-center justify-center gap-2.5 shrink-0 w-full max-w-[680px]">
          <button class="filter-btn active px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal bg-[#1b62f2] text-white shadow-sm transition whitespace-nowrap" data-filter="all">
            All
          </button>
          <button class="filter-btn px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal bg-white text-[#1a1a1a] hover:text-black shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition whitespace-nowrap" data-filter="research">
            Research
          </button>
          <button class="filter-btn px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal bg-white text-[#1a1a1a] hover:text-black shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition whitespace-nowrap" data-filter="account">
            Account
          </button>
        </div>

        <!-- Notification List Container -->
        <div class="w-full max-w-[680px] flex flex-col pt-3 pb-8">
          
          <!-- Unread Label -->
          <span class="text-[12.5px] font-normal text-[#1b62f2] mb-3 select-none">Unread</span>

          <!-- Unread Notifications List -->
          <div class="flex flex-col gap-4">
            {unreadNotifications.map((item) => (
              <div class="notification-item flex items-start justify-between gap-4 py-2 border-b border-transparent hover:bg-neutral-100/40 rounded-xl px-1.5 transition cursor-pointer" data-type={item.type}>
                <div class="flex flex-col min-w-0 pr-2">
                  <h4 class="text-[14px] sm:text-[14.5px] font-semibold text-[#111] leading-snug">
                    {item.title}
                  </h4>
                  <p class="text-[12px] sm:text-[12.5px] text-[#555] mt-1 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <span class="text-[11px] sm:text-[11.5px] text-[#888] shrink-0 font-normal pt-0.5">
                  {item.time}
                </span>
              </div>
            ))}
          </div>

          <!-- Divider Line -->
          <div class="w-full h-[1px] bg-neutral-200/80 my-5"></div>

          <!-- Past Notifications List -->
          <div id="past-notifications" class="flex flex-col gap-4">
            {pastNotifications.map((item) => (
              <div class="notification-item flex items-start justify-between gap-4 py-2 border-b border-transparent hover:bg-neutral-100/40 rounded-xl px-1.5 transition cursor-pointer" data-type={item.type}>
                <div class="flex flex-col min-w-0 pr-2">
                  <h4 class="text-[14px] sm:text-[14.5px] font-semibold text-[#111] leading-snug">
                    {item.title}
                  </h4>
                  <p class="text-[12px] sm:text-[12.5px] text-[#555] mt-1 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <span class="text-[11px] sm:text-[11.5px] text-[#888] shrink-0 font-normal pt-0.5">
                  {item.time}
                </span>
              </div>
            ))}

            <!-- Extra Notifications shown on Show more -->
            <div id="extra-notifications" class="hidden flex-col gap-4">
              {extraPastNotifications.map((item) => (
                <div class="notification-item flex items-start justify-between gap-4 py-2 border-b border-transparent hover:bg-neutral-100/40 rounded-xl px-1.5 transition cursor-pointer" data-type={item.type}>
                  <div class="flex flex-col min-w-0 pr-2">
                    <h4 class="text-[14px] sm:text-[14.5px] font-semibold text-[#111] leading-snug">
                      {item.title}
                    </h4>
                    <p class="text-[12px] sm:text-[12.5px] text-[#555] mt-1 leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                  <span class="text-[11px] sm:text-[11.5px] text-[#888] shrink-0 font-normal pt-0.5">
                    {item.time}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Show More Button -->
          <button
            type="button"
            id="show-more-btn"
            class="mt-6 self-center flex items-center gap-1.5 text-[12.5px] text-[#444] hover:text-black font-medium transition"
          >
            <span id="show-more-text">Show more</span>
            <svg id="show-more-icon" class="w-3.5 h-3.5 text-[#444] transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

        </div>

      </main>

    </div>

    <!-- MOBILE BOTTOM NAVIGATION DOCK -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#f3f3f5]/95 backdrop-blur-lg border-t border-neutral-200/60 px-6 py-2 flex items-center justify-around">
      
      <!-- Discover -->
      <a href="/discover" class="flex flex-col items-center gap-1 text-[#666]" title="Discover">
        <div class="w-10 h-8 flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.31802 19.682C3 18.364 3 16.2426 3 12C3 7.75736 3 5.63604 4.31802 4.31802C5.63604 3 7.75736 3 12 3C16.2426 3 18.364 3 19.682 4.31802C21 5.63604 21 7.75736 21 12C21 16.2426 21 18.364 19.682 19.682C18.364 21 16.2426 21 12 21C7.75736 21 5.63604 21 4.31802 19.682Z" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M7 14L9.79289 11.2071C10.1834 10.8166 10.8166 10.8166 11.2071 11.2071L12.7929 12.7929C13.1834 13.1834 13.8166 13.1834 14.2071 12.7929L17 10" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="text-[10.5px] font-normal">Discover</span>
      </a>

      <!-- Desk -->
      <a href="/desk" class="flex flex-col items-center gap-1 text-[#666]" title="Desk">
        <div class="w-10 h-8 flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.5502 3C6.69782 3.00694 4.6805 3.10152 3.39128 4.39073C2 5.78202 2 8.02125 2 12.4997C2 16.9782 2 19.2174 3.39128 20.6087C4.78257 22 7.0218 22 11.5003 22C15.9787 22 18.218 22 19.6093 20.6087C20.8985 19.3195 20.9931 17.3022 21 13.4498" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11.0557 13C10.3323 3.86635 16.8024 1.27554 21.9806 2.16439C22.1897 5.19136 20.7086 6.32482 17.888 6.84825C18.4327 7.41736 19.3951 8.13354 19.2913 9.02879C19.2174 9.66586 18.7847 9.97843 17.9195 10.6036C16.0232 11.9736 13.8265 12.8375 11.0557 13Z" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 17C11 11.5 12.9604 9.63636 15 8" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="text-[10.5px] font-normal">Desk</span>
      </a>

      <!-- Notification (Active) -->
      <a href="/notification" class="flex flex-col items-center gap-1 text-[#1b62f2]" title="Notification">
        <div class="w-10 h-8 rounded-full bg-[#e8f0fe] flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.5 18C15.5 19.933 13.933 21.5 12 21.5C10.067 21.5 8.5 19.933 8.5 18" stroke="#1B62F2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M19.2311 18H4.76887C3.79195 18 3 17.208 3 16.2311C3 15.762 3.18636 15.3121 3.51809 14.9803L4.12132 14.3771C4.68393 13.8145 5 13.0514 5 12.2558V9.5C5 5.63401 8.13401 2.5 12 2.5C15.866 2.5 19 5.634 19 9.5V12.2558C19 13.0514 19.3161 13.8145 19.8787 14.3771L20.4819 14.9803C20.8136 15.3121 21 15.762 21 16.2311C21 17.208 20.208 18 19.2311 18Z" stroke="#1B62F2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M19 9C21.2088 9 23 7.2088 23 5C23 2.7904 21.2088 1 19 1C16.7912 1 15 2.7904 15 5C15 7.2088 16.7912 9 19 9Z" fill="#2563EB"/>
          </svg>
        </div>
        <span class="text-[10.5px] font-semibold">Alerts</span>
      </a>

      <!-- Account -->
      <a href="/account" class="flex flex-col items-center gap-1 text-[#666]" title="Account">
        <div class="w-10 h-8 flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.4984 19.1511C17.3377 17.4018 15.2947 16.2009 12.9313 16.0569L11.9984 16C11.6652 16.0083 11.3547 16.0194 11.0617 16.0325C8.71722 16.1376 6.66598 17.3796 5.5 19.1511" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.9961 10C14.9961 11.6569 13.6529 13 11.9961 13C10.3392 13 8.99609 11.6569 8.99609 10C8.99609 8.34315 10.3392 7 11.9961 7C13.6529 7 14.9961 8.34315 14.9961 10Z" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#666" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="text-[10.5px] font-normal">Account</span>
      </a>
    </nav>

    <!-- Client Scripts -->
    <script>
      // Tab Filtering
      const filterBtns = document.querySelectorAll(".filter-btn");
      const items = document.querySelectorAll(".notification-item");

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach((b) => {
            b.classList.remove("bg-[#1b62f2]", "text-white", "shadow-sm");
            b.classList.add("bg-white", "text-[#1a1a1a]");
          });
          btn.classList.remove("bg-white", "text-[#1a1a1a]");
          btn.classList.add("bg-[#1b62f2]", "text-white", "shadow-sm");

          const filter = btn.getAttribute("data-filter");
          items.forEach((item) => {
            const type = item.getAttribute("data-type");
            if (filter === "all" || type === filter) {
              (item as HTMLElement).style.display = "flex";
            } else {
              (item as HTMLElement).style.display = "none";
            }
          });
        });
      });

      // Search Filtering
      const searchInput = document.getElementById("notification-search") as HTMLInputElement;
      searchInput?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        items.forEach((item) => {
          const text = item.textContent?.toLowerCase() || "";
          (item as HTMLElement).style.display = text.includes(query) ? "flex" : "none";
        });
      });

      // Show More Toggle
      const showMoreBtn = document.getElementById("show-more-btn");
      const extraNotifications = document.getElementById("extra-notifications");
      const showMoreText = document.getElementById("show-more-text");
      const showMoreIcon = document.getElementById("show-more-icon");

      showMoreBtn?.addEventListener("click", () => {
        if (extraNotifications?.classList.contains("hidden")) {
          extraNotifications.classList.remove("hidden");
          extraNotifications.classList.add("flex");
          if (showMoreText) showMoreText.textContent = "Show less";
          if (showMoreIcon) showMoreIcon.style.transform = "rotate(180deg)";
        } else {
          extraNotifications?.classList.add("hidden");
          extraNotifications?.classList.remove("flex");
          if (showMoreText) showMoreText.textContent = "Show more";
          if (showMoreIcon) showMoreIcon.style.transform = "rotate(0deg)";
        }
      });
    </script>
    <script>
  import { useAuthStore } from "../store/authStore";
  import { apiClient } from "../api/api-client";

  async function quickGuard() {
    const store = useAuthStore.getState();
    if (store.token) return;

    try {
      // Ask backend for a fresh key using the secure cookie
      const res = await apiClient.get("/user/refresh-token");
      if (res.data?.accessToken) {
        store.setToken(res.data.accessToken);
      }
    } catch {
      // If the cookie is dead or missing, bounce them to login
      store.clear();
      window.location.replace("/?auth=login");
    }
  }

  document.addEventListener("astro:page-load", quickGuard);
  quickGuard();
</script>
  </body>
</html>