---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

const THE_EVIDENCE_LOGO =
  "https://pub-d65f9d792dba44cfb4b36fdd1925ed72.r2.dev/theevidence.png";
const GLOBE_THUMB =
  "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";

const filterTabs = [
  { key: "ALL", name: "All", count: "0" },
  { key: "DRAFT", name: "Drafts", count: "0" },
  { key: "PENDING", name: "Pending", count: "0" },
  { key: "PUBLISHED", name: "Published", count: "0" },
  { key: "REJECTED", name: "Rejected", count: "0" },
];
---

<!doctype html>
<html lang="en" class="bg-[#f9f9fb]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <ClientRouter />
    <title>The Evidence - Desk</title>
    <style>
      html,
      body {
        background-color: #f9f9fb !important;
        -webkit-tap-highlight-color: transparent;
      }
      .no-scroll::-webkit-scrollbar {
        display: none;
      }
      .no-scroll {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .safe-bottom {
        padding-bottom: env(safe-area-inset-bottom, 12px);
      }
      @keyframes pulse-subtle {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }
      .skeleton-pulse {
        animation: pulse-subtle 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }
    </style>
  </head>
  <body
    class="bg-[#f9f9fb] text-[#111] antialiased h-screen w-screen overflow-hidden flex flex-col m-0 p-0 font-sans select-none relative"
  >
    <!-- DESKTOP SIDEBAR -->
    <aside
      class="hidden md:flex group absolute top-0 left-0 bottom-0 z-50 w-[74px] hover:w-[220px] bg-[#f9f9fb] hover:shadow-[10px_0_30px_rgba(0,0,0,0.06)] transition-all duration-300 ease-in-out flex-col items-start px-3.5 py-6 shrink-0 border-r border-neutral-200/60"
    >
      <a
        href="/"
        class="flex items-center h-[56px] px-1 mb-6 overflow-hidden shrink-0 w-full"
        title="The Evidence"
      >
        <img
          src={THE_EVIDENCE_LOGO}
          alt="The Evidence"
          class="h-12 w-auto max-w-none object-contain shrink-0"
        />
      </a>

      <nav class="flex flex-col gap-3.5 w-full">
        <a
          href="/discover"
          data-astro-prefetch="hover"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Discover"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0"
            >
              <path
                d="M4.31802 19.682C3 18.364 3 16.2426 3 12C3 7.75736 3 5.63604 4.31802 4.31802C5.63604 3 7.75736 3 12 3C16.2426 3 18.364 3 19.682 4.31802C21 5.63604 21 7.75736 21 12C21 16.2426 21 18.364 19.682 19.682C18.364 21 16.2426 21 12 21C7.75736 21 5.63604 21 4.31802 19.682Z"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M7 14L9.79289 11.2071C10.1834 10.8166 10.8166 10.8166 11.2071 11.2071L12.7929 12.7929C13.1834 13.1834 13.8166 13.8166 14.2071 12.7929L17 10"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <span
            class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4"
            >Discover</span
          >
        </a>

        <a
          href="/desk"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full bg-[#e8f0fe] text-[#0d0d0c] transition-all duration-300 overflow-hidden"
          title="Desk"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0"
            >
              <path
                d="M10.5502 3C6.69782 3.00694 4.6805 3.10152 3.39128 4.39073C2 5.78202 2 8.02125 2 12.4997C2 16.9782 2 19.2174 3.39128 20.6087C4.78257 22 7.0218 22 11.5003 22C15.9787 22 18.218 22 19.6093 20.6087C20.8985 19.3195 20.9931 17.3022 21 13.4498"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M11.0557 13C10.3323 3.86635 16.8024 1.27554 21.9806 2.16439C22.1897 5.19136 20.7086 6.32482 17.888 6.84825C18.4327 7.41736 19.3951 8.13354 19.2913 9.02879C19.2174 9.66586 18.7847 9.97843 17.9195 10.6036C16.0232 11.9736 13.8265 12.8375 11.0557 13Z"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M9 17C11 11.5 12.9604 9.63636 15 8"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <span
            class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4"
            >Desk</span
          >
        </a>

        <a
          href="/notification"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Notification"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0"
            >
              <path
                d="M15.5 18C15.5 19.933 13.933 21.5 12 21.5C10.067 21.5 8.5 19.933 8.5 18"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M19.2311 18H4.76887C3.79195 18 3 17.208 3 16.2311C3 15.762 3.18636 15.3121 3.51809 14.9803L4.12132 14.3771C4.68393 13.8145 5 13.0514 5 12.2558V9.5C5 5.63401 8.13401 2.5 12 2.5C15.866 2.5 19 5.634 19 9.5V12.2558C19 13.0514 19.3161 13.8145 19.8787 14.3771L20.4819 14.9803C20.8136 15.3121 21 15.762 21 16.2311C21 17.208 20.208 18 19.2311 18Z"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M19 9C21.2088 9 23 7.2088 23 5C23 2.7904 21.2088 1 19 1C16.7912 1 15 2.7904 15 5C15 7.2088 16.7912 9 19 9Z"
                fill="#2563EB"></path>
            </svg>
          </div>
          <span
            class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4"
            >Notification</span
          >
        </a>

        <a
          href="/account"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Account"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0"
            >
              <path
                d="M18.4984 19.1511C17.3377 17.4018 15.2947 16.2009 12.9313 16.0569L11.9984 16C11.6652 16.0083 11.3547 16.0194 11.0617 16.0325C8.71722 16.1376 6.66598 17.3796 5.5 19.1511"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M14.9961 10C14.9961 11.6569 13.6529 13 11.9961 13C10.3392 13 8.99609 11.6569 8.99609 10C8.99609 8.34315 10.3392 7 11.9961 7C13.6529 7 14.9961 8.34315 14.9961 10Z"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                stroke="#0D0D0C"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <span
            class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4"
            >Account</span
          >
        </a>
      </nav>
    </aside>

    <!-- TOP HEADER -->
    <header
      class="h-[64px] sm:h-[76px] px-3.5 sm:px-4 md:pl-[90px] md:pr-8 flex items-center justify-between shrink-0 z-20 bg-[#f9f9fb] gap-3"
    >
      <div class="flex items-center gap-2.5 sm:gap-4 shrink-0 mr-1">
        <a href="/" class="flex md:hidden items-center" title="The Evidence">
          <img
            src={THE_EVIDENCE_LOGO}
            alt="The Evidence"
            class="h-7 sm:h-8 w-auto object-contain"
          />
        </a>
        <span
          class="text-[14px] sm:text-[17px] font-bold text-[#111] tracking-tight whitespace-nowrap"
          >Researcher Desk</span
        >
      </div>

      <div class="flex-1 max-w-[560px]">
        <div class="relative w-full">
          <svg
            class="w-3.5 h-3.5 sm:w-4 sm:h-4 absolute left-3.5 sm:left-4 top-1/2 -translate-y-1/2 text-[#666]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="desk-search-input"
            placeholder="Search papers/blogs..."
            class="w-full pl-9 sm:pl-11 pr-3.5 py-2 sm:py-2.5 text-[12px] sm:text-[13px] bg-white text-[#111] placeholder-[#777] rounded-full border border-neutral-200/60 shadow-[0_1px_3px_rgba(0,0,0,0.02)] focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all"
          />
        </div>
      </div>

      <div class="hidden lg:block w-[180px]"></div>
    </header>

    <!-- MOBILE QUICK ACTIONS -->
    <div
      class="flex md:hidden items-center gap-2 px-3.5 pb-2.5 pt-1 shrink-0 bg-[#f9f9fb]"
    >
      <button
        type="button"
        class="btn-trigger-new-creation flex-1 py-2 px-3 bg-[#1b62f2] rounded-full text-xs font-semibold text-white shadow-sm flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
        <span>New Creation</span>
      </button>

      <button
        type="button"
        id="open-drafts-modal"
        class="py-2 px-3.5 bg-white border border-neutral-200/60 rounded-full text-xs font-semibold text-neutral-800 shadow-sm flex items-center justify-center gap-1 active:bg-neutral-50 cursor-pointer"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        <span>Drafts (<span id="mobile-draft-count">0</span>)</span>
      </button>
    </div>

    <!-- MAIN BODY -->
    <div
      class="flex-1 flex px-3.5 sm:px-6 md:pl-[90px] md:pr-8 pb-16 md:pb-6 pt-0 gap-5 lg:gap-7 overflow-hidden max-w-[1600px] w-full mx-auto"
    >
      <div class="flex-1 flex gap-5 lg:gap-7 overflow-hidden">
        <!-- LEFT: FEED CONTAINER -->
        <main
          class="flex-1 h-full overflow-y-auto no-scroll pr-0.5 sm:pr-1 flex flex-col gap-3.5 pb-16 md:pb-4"
        >
          <!-- Status Tabs Filter -->
          <div
            class="sticky top-0 z-10 pb-2 pt-0.5 bg-[#f9f9fb]/95 backdrop-blur-sm flex items-center overflow-x-auto no-scroll gap-2 shrink-0 px-0.5"
          >
            {
              filterTabs.map((tab, idx) => (
                <button
                  type="button"
                  data-status={tab.key}
                  class={`desk-filter-tab px-3.5 sm:px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12px] sm:text-[13px] transition-all whitespace-nowrap shrink-0 cursor-pointer ${
                    idx === 0
                      ? "bg-[#1b62f2] text-white shadow-[0_2px_8px_rgba(27,98,242,0.25)] border border-transparent font-semibold"
                      : "bg-white text-[#1a1a1a] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)]"
                  }`}
                >
                  <span>{tab.name}</span>
                  <span
                    class={`filter-count-badge text-[10.5px] sm:text-[11px] ml-1.5 ${idx === 0 ? "text-white/80" : "text-[#888]"}`}
                  >
                    0
                  </span>
                </button>
              ))
            }
          </div>

          <!-- Rich Full Skeleton Loader (Visible until data fetches) -->
          <div id="desk-loading-skeleton" class="flex flex-col gap-3.5">
            <div
              class="bg-white rounded-[24px] p-5 h-36 shadow-sm border border-neutral-200/50 flex flex-col justify-between skeleton-pulse"
            >
              <div class="flex items-center justify-between">
                <div class="w-20 h-5 bg-neutral-200 rounded-full"></div>
                <div class="w-14 h-4 bg-neutral-200 rounded-full"></div>
              </div>
              <div class="space-y-2">
                <div class="w-4/5 h-4 bg-neutral-200 rounded-lg"></div>
                <div class="w-2/3 h-3 bg-neutral-200 rounded-lg"></div>
              </div>
              <div
                class="flex items-center justify-between pt-2 border-t border-neutral-100"
              >
                <div class="w-28 h-3 bg-neutral-200 rounded-md"></div>
                <div class="w-16 h-3 bg-neutral-200 rounded-md"></div>
              </div>
            </div>
            <div
              class="bg-white rounded-[24px] p-5 h-36 shadow-sm border border-neutral-200/50 flex flex-col justify-between skeleton-pulse"
            >
              <div class="flex items-center justify-between">
                <div class="w-20 h-5 bg-neutral-200 rounded-full"></div>
                <div class="w-14 h-4 bg-neutral-200 rounded-full"></div>
              </div>
              <div class="space-y-2">
                <div class="w-4/5 h-4 bg-neutral-200 rounded-lg"></div>
                <div class="w-2/3 h-3 bg-neutral-200 rounded-lg"></div>
              </div>
              <div
                class="flex items-center justify-between pt-2 border-t border-neutral-100"
              >
                <div class="w-28 h-3 bg-neutral-200 rounded-md"></div>
                <div class="w-16 h-3 bg-neutral-200 rounded-md"></div>
              </div>
            </div>
          </div>

          <!-- Actual Articles Feed -->
          <div id="desk-papers-feed" class="flex flex-col gap-3.5 pb-12 hidden">
          </div>

          <!-- Empty State -->
          <div
            id="no-desk-papers-msg"
            class="hidden flex-col items-center justify-center p-10 text-center bg-white rounded-3xl border border-neutral-200/50"
          >
            <span class="text-3xl mb-2">📄</span>
            <h4 class="font-bold text-neutral-900 text-sm">
              No creations found
            </h4>
            <p class="text-neutral-500 text-xs mt-1">
              Start by choosing to publish a Research Paper or a Blog.
            </p>
          </div>
        </main>

        <!-- RIGHT: SIDEBAR (DESKTOP DRAFTS & ACTIONS) -->
        <aside
          class="hidden md:flex w-[250px] xl:w-[270px] shrink-0 h-full flex-col gap-3.5 overflow-hidden"
        >
          <button
            type="button"
            class="btn-trigger-new-creation w-full h-[50px] bg-white rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex items-center justify-center gap-2 text-[13.5px] font-bold text-[#111] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/40 transition-colors shrink-0 cursor-pointer"
          >
            <svg
              class="w-4 h-4 text-[#1b62f2]"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4v16m8-8H4"></path>
            </svg>
            <span>New Creation</span>
          </button>

          <div class="w-full relative shrink-0">
            <svg
              class="w-3.5 h-3.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#777]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              id="draft-search-input"
              placeholder="Search drafts..."
              class="w-full pl-9 pr-3 py-2 text-[12px] bg-white placeholder-[#777] rounded-full border border-neutral-200/50 shadow-[0_1px_2px_rgba(0,0,0,0.02)] focus:outline-none focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div
            id="desktop-drafts-list"
            class="flex-1 overflow-y-auto no-scroll flex flex-col gap-2.5 pr-0.5 pb-8"
          >
            <div class="text-xs text-neutral-400 text-center py-6">
              Loading drafts...
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <nav
      class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#f9f9fb]/95 backdrop-blur-lg border-t border-neutral-200/60 px-4 py-1.5 flex items-center justify-around h-[56px] safe-bottom shadow-[0_-2px_10px_rgba(0,0,0,0.03)]"
    >
      <a
        href="/discover"
        class="flex flex-col items-center justify-center gap-0.5 flex-1 py-1 text-neutral-500 hover:text-neutral-900"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M8 14l3-3 2 2 3-3"></path>
        </svg>
        <span class="text-[10px] font-medium tracking-tight">Discover</span>
      </a>

      <!-- Active: Desk -->
      <a
        href="/desk"
        class="flex flex-col items-center justify-center gap-0.5 flex-1 py-1 text-[#1b62f2]"
      >
        <div
          class="w-8 h-6 rounded-full bg-[#e8f0fe] flex items-center justify-center"
        >
          <svg
            class="w-5 h-5 overflow-visible"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#1b62f2"
            stroke-width="2"
          >
            <path
              d="M10.5502 3C6.69782 3.00694 4.6805 3.10152 3.39128 4.39073C2 5.78202 2 8.02125 2 12.4997C2 16.9782 2 19.2174 3.39128 20.6087"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M11.0557 13C10.3323 3.86635 16.8024 1.27554 21.9806 2.16439C22.1897 5.19136 20.7086 6.32482 17.888 6.84825"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <span class="text-[10px] font-bold tracking-tight">Desk</span>
      </a>

      <a
        href="/notification"
        class="flex flex-col items-center justify-center gap-0.5 flex-1 py-1 text-neutral-500 hover:text-neutral-900"
      >
        <div class="relative">
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M13.73 21a2 2 0 0 1-3.46 0"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span
            class="w-1.5 h-1.5 rounded-full bg-blue-600 absolute top-0 right-0"
          ></span>
        </div>
        <span class="text-[10px] font-medium tracking-tight">Alerts</span>
      </a>

      <a
        href="/account"
        class="flex flex-col items-center justify-center gap-0.5 flex-1 py-1 text-neutral-500 hover:text-neutral-900"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="7" r="4"></circle>
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        </svg>
        <span class="text-[10px] font-medium tracking-tight">Account</span>
      </a>
    </nav>

    <!-- MODAL: CHOOSE BETWEEN WRITING RESEARCH PAPER OR BLOG -->
    <div
      id="modal-choose-creation"
      class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm hidden flex-col justify-end sm:items-center sm:justify-center p-0 sm:p-4 transition-opacity duration-200"
    >
      <div
        class="bg-[#f9f9fb] sm:bg-white w-full sm:max-w-md rounded-t-[28px] sm:rounded-[28px] p-5 flex flex-col shadow-2xl safe-bottom animate-in slide-in-from-bottom duration-200"
      >
        <div
          class="w-12 h-1.5 bg-neutral-300 rounded-full mx-auto mb-4 sm:hidden shrink-0"
        >
        </div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-base font-bold text-neutral-900">
            What would you like to create?
          </h3>
          <button
            type="button"
            id="btn-close-choose-modal"
            class="text-xs font-semibold text-neutral-500 p-1 cursor-pointer"
            >Close</button
          >
        </div>
        <div class="flex flex-col gap-2.5 py-2">
          <button
            type="button"
            id="btn-create-blog"
            class="flex items-center justify-between px-4 py-3.5 bg-white hover:bg-[#e8f0fe] hover:text-[#1b62f2] rounded-2xl text-xs font-semibold text-neutral-900 border border-neutral-200/50 shadow-sm transition-colors text-left cursor-pointer group"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-8 h-8 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-sm font-bold"
                >✍️</span
              >
              <div>
                <span
                  class="block text-sm font-bold text-neutral-900 group-hover:text-[#1b62f2]"
                  >Write Blog</span
                >
                <span
                  class="block text-[11px] font-normal text-neutral-500 mt-0.5"
                  >Quick thought-driven editor without mandatory research PDFs.</span
                >
              </div>
            </div>
            <span class="text-neutral-400 group-hover:text-[#1b62f2]">→</span>
          </button>

          <button
            type="button"
            id="btn-create-research"
            class="flex items-center justify-between px-4 py-3.5 bg-white hover:bg-[#e8f0fe] hover:text-[#1b62f2] rounded-2xl text-xs font-semibold text-neutral-900 border border-neutral-200/50 shadow-sm transition-colors text-left cursor-pointer group"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-8 h-8 rounded-full bg-blue-100 text-[#1b62f2] flex items-center justify-center text-sm font-bold"
                >🔬</span
              >
              <div>
                <span
                  class="block text-sm font-bold text-neutral-900 group-hover:text-[#1b62f2]"
                  >Research Paper</span
                >
                <span
                  class="block text-[11px] font-normal text-neutral-500 mt-0.5"
                  >Structured academic paper with abstract and attachments.</span
                >
              </div>
            </div>
            <span class="text-neutral-400 group-hover:text-[#1b62f2]">→</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MOBILE DRAFTS SHEET -->
    <div
      id="modal-drafts"
      class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm hidden flex-col justify-end transition-opacity duration-200"
    >
      <div
        class="bg-[#f9f9fb] w-full max-h-[80vh] rounded-t-[28px] p-5 flex flex-col shadow-2xl safe-bottom"
      >
        <div
          class="w-12 h-1.5 bg-neutral-300 rounded-full mx-auto mb-4 shrink-0"
        >
        </div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-base font-bold text-neutral-900">Your Drafts</h3>
          <button
            type="button"
            id="btn-close-drafts-modal"
            class="text-xs font-semibold text-neutral-500 p-1 cursor-pointer"
            >Close</button
          >
        </div>
        <div
          id="mobile-drafts-container"
          class="overflow-y-auto no-scroll flex flex-col gap-2 py-2"
        >
          <div class="text-xs text-neutral-400 text-center py-4">
            Loading drafts...
          </div>
        </div>
      </div>
    </div>

    <!-- CLIENT SCRIPT -->
    <script>
      import { apiClient } from "../api/api-client";

      const GLOBE_THUMB =
        "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";

      async function loadDeskData() {
        const filterTabs = document.querySelectorAll(".desk-filter-tab");
        const mainSearch = document.getElementById(
          "desk-search-input",
        ) as HTMLInputElement;
        const draftSearch = document.getElementById(
          "draft-search-input",
        ) as HTMLInputElement;
        const papersFeed = document.getElementById("desk-papers-feed");
        const skeleton = document.getElementById("desk-loading-skeleton");
        const noPapersMsg = document.getElementById("no-desk-papers-msg");
        const desktopDraftsList = document.getElementById(
          "desktop-drafts-list",
        );
        const mobileDraftsContainer = document.getElementById(
          "mobile-drafts-container",
        );
        const mobileDraftCount = document.getElementById("mobile-draft-count");

        // Mobile Drafts Sheet Toggle
        const draftsModal = document.getElementById("modal-drafts");
        const openDraftsBtn = document.getElementById("open-drafts-modal");
        const closeDraftsBtn = document.getElementById(
          "btn-close-drafts-modal",
        );

        if (openDraftsBtn) {
          openDraftsBtn.onclick = () => {
            draftsModal?.classList.remove("hidden");
            draftsModal?.classList.add("flex");
          };
        }
        if (closeDraftsBtn) {
          closeDraftsBtn.onclick = () => {
            draftsModal?.classList.add("hidden");
            draftsModal?.classList.remove("flex");
          };
        }

        // Creation Modal Triggers
        const chooseModal = document.getElementById("modal-choose-creation");
        const closeChooseBtn = document.getElementById(
          "btn-close-choose-modal",
        );
        const btnCreateBlog = document.getElementById("btn-create-blog");
        const btnCreateResearch = document.getElementById(
          "btn-create-research",
        );

        document
          .querySelectorAll(".btn-trigger-new-creation")
          .forEach((btn) => {
            (btn as HTMLElement).onclick = () => {
              chooseModal?.classList.remove("hidden");
              chooseModal?.classList.add("flex");
            };
          });

        if (closeChooseBtn) {
          closeChooseBtn.onclick = () => {
            chooseModal?.classList.add("hidden");
            chooseModal?.classList.remove("flex");
          };
        }

        if (btnCreateBlog) {
          btnCreateBlog.onclick = () => {
            localStorage.setItem(
              "the_evidence_editor_state_v15",
              JSON.stringify({
                docType: "BLOG",
                content: "",
                title: "",
                excerpt: "",
                category: "",
              }),
            );
            window.location.href = "/desk/new?type=blog";
          };
        }

        if (btnCreateResearch) {
          btnCreateResearch.onclick = () => {
            localStorage.setItem(
              "the_evidence_editor_state_v15",
              JSON.stringify({
                docType: "RESEARCH",
                content: "",
                title: "",
                excerpt: "",
                category: "",
              }),
            );
            window.location.href = "/desk/new?type=research";
          };
        }

        let activeStatus = "ALL";
        let allPapers: any[] = [];
        let allDrafts: any[] = [];

        function updateCounts(papers: any[], serverCounts?: any) {
          const counts: Record<string, number> = {
            ALL: papers.length,
            PUBLISHED: papers.filter(
              (p) => (p.status || "").toUpperCase() === "PUBLISHED",
            ).length,
            DRAFT: papers.filter(
              (p) => (p.status || "").toUpperCase() === "DRAFT",
            ).length,
            PENDING: papers.filter(
              (p) => (p.status || "").toUpperCase() === "PENDING",
            ).length,
            REJECTED: papers.filter(
              (p) => (p.status || "").toUpperCase() === "REJECTED",
            ).length,
          };

          if (serverCounts) Object.assign(counts, serverCounts);

          filterTabs.forEach((tab) => {
            const statusKey = tab.getAttribute("data-status") || "ALL";
            const badge = tab.querySelector(".filter-count-badge");
            if (badge) badge.textContent = String(counts[statusKey] ?? 0);
          });

          if (mobileDraftCount) {
            mobileDraftCount.textContent = String(counts.DRAFT ?? 0);
          }
        }

        function renderCards() {
          if (!papersFeed) return;
          const query = mainSearch ? mainSearch.value.toLowerCase().trim() : "";
          papersFeed.innerHTML = "";

          const filtered = allPapers.filter((item) => {
            const matchesStatus =
              activeStatus === "ALL" ||
              (item.status || "").toUpperCase() === activeStatus;
            const matchesSearch =
              !query ||
              (item.title || "").toLowerCase().includes(query) ||
              (item.category || "").toLowerCase().includes(query) ||
              (item.excerpt || "").toLowerCase().includes(query);
            return matchesStatus && matchesSearch;
          });

          if (filtered.length === 0) {
            noPapersMsg?.classList.remove("hidden");
            noPapersMsg?.classList.add("flex");
          } else {
            noPapersMsg?.classList.add("hidden");
            noPapersMsg?.classList.remove("flex");

            filtered.forEach((item, idx) => {
              const status = (item.status || "PUBLISHED").toUpperCase();
              const pubDate =
                item.publishedAt || item.createdAt
                  ? new Date(
                      item.publishedAt || item.createdAt,
                    ).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })
                  : "Aug 20, 2026";

              const thumb = item.coverImage?.url || GLOBE_THUMB;

              const gradients = [
                "bg-gradient-to-br from-[#e0f2fe]/90 via-[#f0f9ff]/70 to-[#dcfce7]/80",
                "bg-gradient-to-br from-[#ecfdf5]/90 via-[#f0fdf4]/70 to-[#fdf4ff]/80",
                "bg-gradient-to-br from-[#faf5ff]/95 via-[#fdf4ff]/70 to-[#fff7ed]/80",
                "bg-gradient-to-br from-[#fff7ed]/95 via-[#fffbeb]/70 to-[#e0f2fe]/80",
              ];
              const cardBg = gradients[idx % gradients.length];

              let cleanExcerpt = item.excerpt || "";
              if (!cleanExcerpt && item.content) {
                const textOnly = item.content.replace(/<[^>]*>/g, "").trim();
                cleanExcerpt =
                  textOnly.length > 150
                    ? textOnly.substring(0, 150) + "..."
                    : textOnly;
              }
              const finalExcerpt =
                cleanExcerpt || "No abstract or description provided.";

              const article = document.createElement("article");
              article.className = `paper-card ${cardBg} rounded-[24px] sm:rounded-[28px] border border-neutral-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.06)] flex flex-row overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.1)] cursor-pointer group`;

              article.innerHTML = `
                <div class="w-[130px] sm:w-[240px] shrink-0 bg-neutral-900 relative overflow-hidden">
                  <img src="${thumb}" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                </div>
                <div class="flex-1 p-3.5 sm:p-7 flex flex-col justify-between min-w-0">
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center justify-between gap-1.5">
                      <span class="inline-block px-2.5 py-0.5 sm:px-3.5 sm:py-1 bg-[#dbeafe] text-[#1d4ed8] rounded-full text-[9.5px] sm:text-[11px] font-bold tracking-wider uppercase shadow-sm">
                        ${item.category || "General"}
                      </span>
                      <span class="text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider ${
                        status === "PUBLISHED"
                          ? "bg-emerald-50 text-emerald-600 border border-emerald-200/60"
                          : status === "DRAFT"
                            ? "bg-amber-50 text-amber-600 border border-amber-200/60"
                            : status === "REJECTED"
                              ? "bg-rose-50 text-rose-600 border border-rose-200/60"
                              : "bg-blue-50 text-blue-600 border border-blue-200/60"
                      }">
                        ${status}
                      </span>
                    </div>
                    <a href="/papers/${item.slug || item._id}" class="hover:text-[#1b62f2] transition-colors mt-0.5 sm:mt-1">
                      <h3 class="text-[14px] sm:text-[19px] font-extrabold text-[#0f172a] group-hover:text-[#1b62f2] leading-[1.3] sm:leading-[1.35] tracking-tight line-clamp-2 transition-colors">
                        ${item.title || "Untitled Creation"}
                      </h3>
                    </a>
                  </div>

                  <p class="text-[12px] sm:text-[14px] text-[#475569] leading-[1.4] line-clamp-2 my-1.5 sm:my-2.5 font-normal">
                    ${finalExcerpt}
                  </p>

                  <div class="flex items-center justify-between text-[11px] sm:text-[12px] text-[#64748b] pt-1.5 sm:pt-2 border-t border-neutral-200/60 flex-wrap font-medium">
                    <div class="flex items-center gap-1.5">
                      <span class="text-[#0f172a] font-bold">${pubDate}</span>
                      <span>•</span>
                      <span>${item.views || 0} views</span>
                    </div>
                    <a href="/papers/${item.slug || item._id}" class="text-[#1b62f2] hover:underline font-bold text-xs flex items-center gap-0.5">
                      View →
                    </a>
                  </div>
                </div>
              `;
              papersFeed.appendChild(article);
            });
          }
        }

        function renderDrafts(drafts: any[]) {
          if (desktopDraftsList) desktopDraftsList.innerHTML = "";
          if (mobileDraftsContainer) mobileDraftsContainer.innerHTML = "";

          if (drafts.length === 0) {
            const emptyMsg = `<div class="text-xs text-neutral-400 text-center py-6">No saved drafts.</div>`;
            if (desktopDraftsList) desktopDraftsList.innerHTML = emptyMsg;
            if (mobileDraftsContainer)
              mobileDraftsContainer.innerHTML = emptyMsg;
            return;
          }

          drafts.forEach((draft, idx) => {
            const edited = draft.updatedAt
              ? new Date(draft.updatedAt).toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  hour: "2-digit",
                  minute: "2-digit",
                })
              : "Recently";

            const isBlog = draft.docType === "BLOG";

            if (desktopDraftsList) {
              const div = document.createElement("div");
              div.className =
                "draft-item bg-white rounded-2xl p-3.5 shadow-[0_1px_3px_rgba(0,0,0,0.02)] border border-neutral-200/40 flex flex-col gap-2 shrink-0 hover:bg-[#e8f0fe] transition-colors cursor-pointer group";
              div.innerHTML = `
                <div class="flex items-start gap-3">
                  <img src="${draft.coverImage?.url || GLOBE_THUMB}" alt="" class="w-10 h-10 rounded-xl object-cover shrink-0 bg-[#0f172a]" />
                  <div class="flex flex-col min-w-0 flex-1">
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded ${isBlog ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700"}">${isBlog ? "BLOG" : "RESEARCH"}</span>
                      <span class="text-[10px] text-[#888] font-medium leading-tight truncate">${draft.category || "General"}</span>
                    </div>
                    <h4 class="text-[12.5px] font-semibold text-[#111] group-hover:text-[#1b62f2] leading-tight line-clamp-1 transition-colors">${draft.title || (isBlog ? "Untitled Blog" : "Untitled Manuscript")}</h4>
                  </div>
                </div>
                <div class="flex items-center justify-between text-[11px] pt-1.5 border-t border-neutral-100">
                  <span class="text-[#1b62f2] font-bold group-hover:underline">Continue writing →</span>
                  <span class="text-[#999] text-[10px]">${edited}</span>
                </div>
              `;
              div.onclick = () => {
                const state = {
                  title: draft.title || "",
                  excerpt: draft.excerpt || "",
                  content: draft.content || "",
                  category: draft.category || "",
                  docType: draft.docType || "RESEARCH",
                  coverImageBase64: draft.coverImage?.url || "",
                  pdfAttachments: draft.pdfs || [],
                  updatedAt: Date.now(),
                };
                localStorage.setItem(
                  "the_evidence_editor_state_v15",
                  JSON.stringify(state),
                );
                const targetType = (
                  draft.docType || "RESEARCH"
                ).toLowerCase();
                window.location.href = `/desk/new?type=${targetType}`;
              };
              desktopDraftsList.appendChild(div);
            }

            if (mobileDraftsContainer) {
              const mDiv = document.createElement("div");
              mDiv.className =
                "bg-white rounded-2xl p-3 shadow-sm border border-neutral-200/60 flex flex-col gap-1.5 cursor-pointer active:bg-neutral-50";
              mDiv.innerHTML = `
                <div class="flex items-center gap-1.5">
                  <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded ${isBlog ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700"}">${isBlog ? "BLOG" : "RESEARCH"}</span>
                  <span class="text-[10px] font-bold text-neutral-500">${draft.category || "General"}</span>
                </div>
                <h4 class="text-xs font-bold text-neutral-900 line-clamp-1">${draft.title || "Untitled Creation"}</h4>
                <div class="flex items-center justify-between pt-1.5 border-t border-neutral-100 text-xs">
                  <span class="text-[10px] text-neutral-400">${edited}</span>
                  <span class="text-[#1b62f2] font-bold text-xs">Edit Draft →</span>
                </div>
              `;
              mDiv.onclick = () => {
                const state = {
                  title: draft.title || "",
                  excerpt: draft.excerpt || "",
                  content: draft.content || "",
                  category: draft.category || "",
                  docType: draft.docType || "RESEARCH",
                  coverImageBase64: draft.coverImage?.url || "",
                  pdfAttachments: draft.pdfs || [],
                  updatedAt: Date.now(),
                };
                localStorage.setItem(
                  "the_evidence_editor_state_v15",
                  JSON.stringify(state),
                );
                const targetType = (
                  draft.docType || "RESEARCH"
                ).toLowerCase();
                window.location.href = `/desk/new?type=${targetType}`;
              };
              mobileDraftsContainer.appendChild(mDiv);
            }
          });
        }

        try {
          let response: any;
          try {
            response = await apiClient.get("/blog/overview");
          } catch {
            response = await apiClient.get("/blog/getall");
          }

          if (response?.data?.success || response?.status === 200) {
            const resData = response.data || {};
            allPapers =
              resData.papers ||
              resData.blogs ||
              (Array.isArray(resData) ? resData : []);
            allDrafts =
              resData.drafts ||
              allPapers.filter(
                (p) => (p.status || "").toUpperCase() === "DRAFT",
              );

            updateCounts(allPapers, resData.counts || resData.stats);
            renderDrafts(allDrafts);
            renderCards();
          }
        } catch (error: any) {
          console.error("Desk load error:", error);
          if (error.response?.status === 401) {
            window.location.href = "/?auth=login";
          }
        } finally {
          skeleton?.classList.add("hidden");
          papersFeed?.classList.remove("hidden");
        }

        // Tab Filter Listener
        filterTabs.forEach((tab) => {
          (tab as HTMLElement).onclick = () => {
            activeStatus = tab.getAttribute("data-status") || "ALL";
            filterTabs.forEach((t) => {
              t.classList.remove(
                "bg-[#1b62f2]",
                "text-white",
                "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
                "border-transparent",
              );
              t.classList.add(
                "bg-white",
                "text-[#1a1a1a]",
                "hover:bg-[#e8f0fe]",
                "hover:text-[#1b62f2]",
                "border",
                "border-neutral-200/60",
                "shadow-[0_1px_2px_rgba(0,0,0,0.02)]",
              );
              t.querySelector(".filter-count-badge")?.classList.replace(
                "text-white/80",
                "text-[#888]",
              );
            });

            tab.classList.remove(
              "bg-white",
              "text-[#1a1a1a]",
              "hover:bg-[#e8f0fe]",
              "hover:text-[#1b62f2]",
              "border",
              "border-neutral-200/60",
              "shadow-[0_1px_2px_rgba(0,0,0,0.02)]",
            );
            tab.classList.add(
              "bg-[#1b62f2]",
              "text-white",
              "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
              "border-transparent",
            );
            tab
              .querySelector(".filter-count-badge")
              ?.classList.replace("text-[#888]", "text-white/80");

            renderCards();
          };
        });

        if (mainSearch) mainSearch.oninput = renderCards;
        if (draftSearch) {
          draftSearch.oninput = (e: any) => {
            const q = e.target.value.toLowerCase().trim();
            document.querySelectorAll(".draft-item").forEach((item) => {
              (item as HTMLElement).style.display = (
                item.textContent?.toLowerCase() || ""
              ).includes(q)
                ? "flex"
                : "none";
            });
          };
        }
      }

      document.addEventListener("astro:page-load", loadDeskData);
      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        loadDeskData();
      }
    </script>

    <script>
  import { useAuthStore } from "../store/authStore";
  import { apiClient } from "../api/api-client";

  async function quickGuard() {
    const store = useAuthStore.getState();
    if (store.token) return;

    try {
      // Try to silently refresh the session using your secure HttpOnly cookie
      const res = await apiClient.get("/user/refresh-token");
      if (res.data?.accessToken) {
        store.setToken(res.data.accessToken);
      }
    } catch {
      // If the session is invalid or missing, clear storage and send them to the homepage
      store.clear();
      if (window.location.pathname !== "/") {
        window.location.replace("/");
      }
    }
  }

  document.addEventListener("astro:page-load", quickGuard);
  quickGuard();
</script>
    
  </body>
</html>