    <!-- MODERN HYPERLINK MODAL -->
    <div id="link-modal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 shadow-2xl border border-neutral-200/80 w-full max-w-md flex flex-col gap-4 animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
          <h3 class="font-bold text-sm text-neutral-900 flex items-center gap-2">
            <span>🔗 Insert Hyperlink</span>
          </h3>
          <button type="button" id="btn-close-link-modal" class="text-neutral-400 hover:text-neutral-700 font-bold">✕</button>
        </div>
        
        <div class="flex flex-col gap-3">
          <div id="link-text-group" class="flex flex-col gap-1">
            <label for="link-text-input" class="text-xs font-semibold text-neutral-600">Display Text</label>
            <input type="text" id="link-text-input" placeholder="e.g. Read Research Paper" class="w-full px-4 py-2 rounded-xl bg-neutral-50 border border-neutral-200 text-sm outline-none focus:border-blue-500 focus:bg-white transition" />
          </div>

          <div class="flex flex-col gap-1">
            <label for="link-url-input" class="text-xs font-semibold text-neutral-600">Web URL</label>
            <input type="url" id="link-url-input" placeholder="https://evidence.org" class="w-full px-4 py-2 rounded-xl bg-neutral-50 border border-neutral-200 text-sm outline-none focus:border-blue-500 focus:bg-white transition" />
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" id="btn-cancel-link" class="px-4 py-2 rounded-xl text-xs font-semibold text-neutral-600 hover:bg-neutral-100 transition">Cancel</button>
          <button type="button" id="btn-confirm-link" class="px-5 py-2 rounded-xl text-xs font-bold bg-[#1b62f2] text-white hover:bg-blue-600 transition shadow-sm">Insert Link</button>
