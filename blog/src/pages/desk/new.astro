    <!-- PUBLISHED SUCCESS MODAL -->
    <div id="success-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-md z-[110] flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-8 shadow-2xl border border-neutral-200/80 w-full max-w-sm flex flex-col items-center text-center gap-4 animate-in fade-in zoom-in-95 duration-200">
        <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl shadow-sm">
          ✓
        </div>
        <div class="flex flex-col gap-1">
          <h3 class="text-lg font-extrabold text-neutral-900">Blog Submitted & Published!</h3>
          <p class="text-xs text-neutral-500">Your research paper is live. Redirecting you to Discover...</p>
        </div>
        <button type="button" id="btn-go-discover" class="w-full py-3 bg-[#111] hover:bg-black text-white rounded-2xl text-xs font-bold transition shadow-md">
          Go to Discover Now
        </button>
      </div>
    </div>

    <!-- Client-Side Engine -->
    <script is:inline>
      let quillInstance = null;
      let pdfFiles = [];
      let selectedCategory = "";
      let lastSavedRange = null;
      let pendingCsvData = null;
      let activeSelectedImageNode = null;
      const STORAGE_KEY = "the_evidence_editor_state_v13";

      function initStudio() {
        const titleField = document.getElementById("field-title");
        const excerptField = document.getElementById("field-excerpt");
        const autosaveLabel = document.getElementById("autosave-label");
        const catLabel = document.getElementById("selected-category-label");
        const catDot = document.getElementById("category-dot");
        const catBtn = document.getElementById("btn-category-toggle");

        // Size Whitelist for Quill
        if (window.Quill) {
          const SizeStyle = window.Quill.import("attributors/style/size");
          SizeStyle.whitelist = ["14px", "16px", "18px", "20px", "24px"];
          window.Quill.register(SizeStyle, true);
        }

        // 1. Initialize Quill Instance
        if (!quillInstance && window.Quill && document.getElementById("quill-editor-container")) {
          quillInstance = new window.Quill("#quill-editor-container", {
            theme: "snow",
            placeholder: "Start writing Introduction, Methodology, Findings, and Conclusions here...",
            modules: { toolbar: false }
          });

          quillInstance.on("selection-change", (range) => {
            if (range) {
              lastSavedRange = range;
            }
          });

          // Accurate Image Delete Button Positioning Engine
          const editorContainer = document.getElementById("quill-editor-container");
          const mediaActionBar = document.getElementById("media-action-bar");

          editorContainer?.addEventListener("click", (e) => {
            const target = e.target;
            if (target && target.tagName === "IMG") {
              activeSelectedImageNode = target;
              
              // Anchor delete pill to top-right of image inside the editor container
              const targetOffsetTop = target.offsetTop;
              const targetOffsetLeft = target.offsetLeft;
              const targetWidth = target.offsetWidth;

              mediaActionBar.style.top = `${targetOffsetTop + 36}px`;
              mediaActionBar.style.left = `${targetOffsetLeft + targetWidth - 90}px`;
              mediaActionBar.classList.remove("hidden");
              mediaActionBar.classList.add("flex");
            } else {
              mediaActionBar.classList.add("hidden");
              mediaActionBar.classList.remove("flex");
              activeSelectedImageNode = null;
            }
          });

          document.getElementById("btn-delete-active-media")?.addEventListener("click", () => {
            if (activeSelectedImageNode) {
              const blot = window.Quill.find(activeSelectedImageNode);
              if (blot) {
                blot.deleteAt(0);
              } else {
                activeSelectedImageNode.remove();
              }
              mediaActionBar.classList.add("hidden");
              mediaActionBar.classList.remove("flex");
              activeSelectedImageNode = null;
              triggerAutosave();
            }
          });
        }

        // Prevent toolbar buttons from clearing selection
        document.querySelectorAll("#format-dock button, #heading-size-menu button").forEach((btn) => {
          btn.addEventListener("mousedown", (e) => {
            e.preventDefault();
          });
        });

        // 2. Guaranteed Formatting Functions
        function applyInlineFormat(formatName) {
          if (!quillInstance) return;
          quillInstance.focus();
          const range = quillInstance.getSelection() || lastSavedRange;
          if (!range) return;

          const currentFormats = quillInstance.getFormat(range);
          const isActive = !!currentFormats[formatName];
          
          if (range.length > 0) {
            quillInstance.formatText(range.index, range.length, formatName, !isActive);
          } else {
            quillInstance.format(formatName, !isActive);
          }
          triggerAutosave();
        }

        function applyBlockFormat(formatName, value) {
          if (!quillInstance) return;
          quillInstance.focus();
          const range = quillInstance.getSelection() || lastSavedRange;
          if (!range) return;

          const currentFormats = quillInstance.getFormat(range);
          const currentVal = currentFormats[formatName];
          const newVal = currentVal === value ? false : value;
          
          quillInstance.formatLine(range.index, range.length, formatName, newVal);
          triggerAutosave();
        }

        document.getElementById("btn-dock-bold")?.addEventListener("click", () => applyInlineFormat("bold"));
        document.getElementById("btn-dock-underline")?.addEventListener("click", () => applyInlineFormat("underline"));
        document.getElementById("btn-dock-italic")?.addEventListener("click", () => applyInlineFormat("italic"));
        
        document.getElementById("btn-dock-ol")?.addEventListener("click", () => applyBlockFormat("list", "ordered"));
        document.getElementById("btn-dock-ul")?.addEventListener("click", () => applyBlockFormat("list", "bullet"));
        document.getElementById("btn-dock-quote")?.addEventListener("click", () => applyBlockFormat("blockquote", true));

        // 3. Modern Link Modal Handlers
        const linkModal = document.getElementById("link-modal");
        const linkTextInput = document.getElementById("link-text-input");
        const linkUrlInput = document.getElementById("link-url-input");
        const linkTextGroup = document.getElementById("link-text-group");

        document.getElementById("btn-dock-link-trigger")?.addEventListener("click", () => {
          if (!quillInstance) return;
          const range = quillInstance.getSelection() || lastSavedRange;
          
          if (range && range.length > 0) {
            const selectedText = quillInstance.getText(range.index, range.length);
            linkTextInput.value = selectedText;
            linkTextGroup.classList.add("hidden");
          } else {
            linkTextInput.value = "";
            linkTextGroup.classList.remove("hidden");
          }

          linkUrlInput.value = "";
          linkModal.classList.remove("hidden");
          linkUrlInput.focus();
        });

        function closeLinkModal() {
          linkModal.classList.add("hidden");
        }

        document.getElementById("btn-close-link-modal")?.addEventListener("click", closeLinkModal);
        document.getElementById("btn-cancel-link")?.addEventListener("click", closeLinkModal);

        document.getElementById("btn-confirm-link")?.addEventListener("click", () => {
          let url = linkUrlInput.value.trim();
          if (!url) return;
          if (!/^https?:\/\//i.test(url)) {
            url = "https://" + url;
          }

          if (quillInstance) {
            quillInstance.focus();
            const range = quillInstance.getSelection() || lastSavedRange;
            if (range && range.length > 0) {
              quillInstance.formatText(range.index, range.length, "link", url);
            } else {
              const text = linkTextInput.value.trim() || url;
              const idx = range ? range.index : quillInstance.getLength();
              quillInstance.insertText(idx, text, "link", url);
              quillInstance.setSelection(idx + text.length);
            }
            triggerAutosave();
          }

          closeLinkModal();
        });

        // 4. Heading & Size Selector
        const headingToggleBtn = document.getElementById("btn-heading-popup-toggle");
        const headingMenu = document.getElementById("heading-size-menu");
        const headingArrow = document.getElementById("heading-arrow");
        const activeHeadingLabel = document.getElementById("active-heading-label");
        const activeSizeLabel = document.getElementById("active-size-label");

        headingToggleBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const isHidden = headingMenu?.classList.contains("hidden");
          if (isHidden) {
            headingMenu?.classList.remove("hidden");
            headingArrow?.classList.add("rotate-180");
          } else {
            headingMenu?.classList.add("hidden");
            headingArrow?.classList.remove("rotate-180");
          }
        });

        document.addEventListener("click", (e) => {
          if (!headingMenu?.contains(e.target) && !headingToggleBtn?.contains(e.target)) {
            headingMenu?.classList.add("hidden");
            headingArrow?.classList.remove("rotate-180");
          }
        });

        document.querySelectorAll(".size-opt-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const level = parseInt(btn.getAttribute("data-level") || "0", 10);
            const size = btn.getAttribute("data-size") || "16px";
            const label = btn.getAttribute("data-label") || "Body";

            if (activeHeadingLabel) activeHeadingLabel.textContent = label;
            if (activeSizeLabel) activeSizeLabel.textContent = size;

            if (quillInstance) {
              quillInstance.focus();
              const range = quillInstance.getSelection() || lastSavedRange;

              if (level > 0) {
                if (range) {
                  quillInstance.formatLine(range.index, range.length, "header", level);
                } else {
                  quillInstance.format("header", level);
                }
              } else {
                if (range) {
                  quillInstance.formatLine(range.index, range.length, "header", false);
                  if (range.length > 0) {
                    quillInstance.formatText(range.index, range.length, "size", size);
                  } else {
                    quillInstance.format("size", size);
                  }
                } else {
                  quillInstance.format("header", false);
                  quillInstance.format("size", size);
                }
              }
            }

            headingMenu?.classList.add("hidden");
            headingArrow?.classList.remove("rotate-180");
            triggerAutosave();
          });
        });

        // 5. Image Inline Insertion (With Navigation Blank Node Below)
        const inlineImgFile = document.getElementById("inline-img-file");
        inlineImgFile?.addEventListener("change", (e) => {
          const file = e.target.files?.[0];
          if (file && quillInstance) {
            const reader = new FileReader();
            reader.onload = (re) => {
              const range = quillInstance.getSelection(true) || { index: quillInstance.getLength() };
              quillInstance.insertEmbed(range.index, "image", re.target?.result);
              quillInstance.insertText(range.index + 1, "\n");
              quillInstance.setSelection(range.index + 2);
              triggerAutosave();
            };
            reader.readAsDataURL(file);
          }
          inlineImgFile.value = "";
        });

        // 6. CSV Interactive Graph Generator (Instant 1-Click Execution)
        const graphModal = document.getElementById("graph-modal");
        const graphFileLabel = document.getElementById("graph-file-label");
        const inlineCsvFile = document.getElementById("inline-csv-file");

        inlineCsvFile?.addEventListener("change", (e) => {
          const file = e.target.files?.[0];
          if (!file) return;

          const reader = new FileReader();
          reader.onload = () => {
            pendingCsvData = {
              text: String(reader.result),
              name: file.name
            };
            if (graphFileLabel) graphFileLabel.textContent = `File: ${file.name}`;
            graphModal.classList.remove("hidden");
          };
          reader.readAsText(file);
          inlineCsvFile.value = "";
        });

        function closeGraphModal() {
          graphModal.classList.add("hidden");
          pendingCsvData = null;
        }

        document.getElementById("btn-close-graph-modal")?.addEventListener("click", closeGraphModal);
        document.getElementById("btn-cancel-graph")?.addEventListener("click", closeGraphModal);

        async function renderSelectedChart(text, fileName, chartType) {
          const lines = text.split(/\r\n|\n/).map((r) => r.trim()).filter(Boolean);
          if (lines.length < 2) return null;

          const rawRows = lines.map((line) =>
            line.split(",").map((cell) => cell.trim().replace(/^["']|["']$/g, ""))
          );

          const sampleRow = rawRows[1] || rawRows[0];
          let labelIdx = -1, valIdx = -1;

          for (let i = 0; i < sampleRow.length; i++) {
            const val = Number(sampleRow[i].replace(/[^0-9.-]+/g, ""));
            if (!isNaN(val) && sampleRow[i] !== "" && valIdx === -1) {
              valIdx = i;
            } else if (labelIdx === -1) {
              labelIdx = i;
            }
          }

          if (labelIdx === -1) labelIdx = 0;
          if (valIdx === -1) valIdx = 1;

          const labels = [];
          const data = [];

          for (let i = 1; i < rawRows.length; i++) {
            const row = rawRows[i];
            if (row.length <= Math.max(labelIdx, valIdx)) continue;
            const label = row[labelIdx];
            const num = Number(row[valIdx].replace(/[^0-9.-]+/g, ""));
            if (label && !isNaN(num)) {
              labels.push(label);
              data.push(num);
            }
            if (labels.length >= 8) break;
          }

          if (!data.length) return null;

          const canvas = document.createElement("canvas");
          canvas.width = 760;
          canvas.height = 380;

          const palette = [
            "rgba(27, 98, 242, 0.85)",
            "rgba(16, 185, 129, 0.85)",
            "rgba(245, 158, 11, 0.85)",
            "rgba(239, 68, 68, 0.85)",
            "rgba(139, 92, 246, 0.85)",
            "rgba(236, 72, 153, 0.85)",
            "rgba(14, 165, 233, 0.85)",
            "rgba(100, 116, 139, 0.85)"
          ];

          if (window.Chart) {
            const chart = new window.Chart(canvas, {
              type: chartType,
              data: {
                labels: labels,
                datasets: [{
                  label: fileName,
                  data: data,
                  backgroundColor: chartType === "bar" ? "rgba(27, 98, 242, 0.85)" : palette,
                  borderColor: chartType === "line" ? "rgba(27, 98, 242, 1)" : "#ffffff",
                  borderWidth: chartType === "line" ? 3 : 1.5,
                  borderRadius: chartType === "bar" ? 8 : 0,
                  fill: chartType === "line",
                  tension: 0.35,
                }]
              },
              options: {
                responsive: false,
                animation: false,
                plugins: {
                  title: {
                    display: true,
                    text: `Dataset: ${fileName}`,
                    font: { size: 16, weight: "bold", family: "'Plus Jakarta Sans', sans-serif" },
                    color: "#0f172a",
                    padding: { top: 16, bottom: 16 }
                  },
                  legend: {
                    display: chartType !== "bar" && chartType !== "line",
                    position: "bottom"
                  }
                },
                scales: (chartType === "bar" || chartType === "line") ? {
                  x: { grid: { display: false }, ticks: { color: "#475569", font: { size: 11 } } },
                  y: { grid: { color: "#f1f5f9" }, ticks: { color: "#64748b", font: { size: 11 } } }
                } : {}
              },
              plugins: [{
                id: "bg_color",
                beforeDraw: (c) => {
                  const { ctx } = c;
                  ctx.save();
                  ctx.globalCompositeOperation = "destination-over";
                  ctx.fillStyle = "#ffffff";
                  ctx.fillRect(0, 0, c.width, c.height);
                  ctx.restore();
                }
              }]
            });

            const dataUrl = canvas.toDataURL("image/png");
            chart.destroy();
            return dataUrl;
          }

          return null;
        }

        // Instant graph creation upon selecting the chart card
        document.querySelectorAll(".graph-type-card").forEach((card) => {
          card.addEventListener("click", async () => {
            const chartType = card.getAttribute("data-type") || "bar";
            if (!pendingCsvData) return;

            const chartImageUrl = await renderSelectedChart(pendingCsvData.text, pendingCsvData.name, chartType);
            
            if (chartImageUrl && quillInstance) {
              const range = quillInstance.getSelection(true) || { index: quillInstance.getLength() };
              quillInstance.insertEmbed(range.index, "image", chartImageUrl);
              quillInstance.insertText(range.index + 1, "\n");
              quillInstance.setSelection(range.index + 2);
              triggerAutosave();
            } else {
              alert("Could not generate graph. Please check your CSV format.");
            }

            closeGraphModal();
          });
        });

        // 7. PDF Attachments Management (Max 3)
        const pdfInput = document.getElementById("pdf-input");
        const filesListContainer = document.getElementById("attached-files-list");
        const pdfCountBadge = document.getElementById("pdf-count-badge");
        const pdfUploadBtn = document.getElementById("pdf-upload-btn");

        function renderFileList() {
          if (!filesListContainer || !pdfCountBadge) return;
          filesListContainer.innerHTML = "";
          pdfCountBadge.textContent = `${pdfFiles.length} / 3 PDFs`;

          if (pdfFiles.length >= 3) {
            pdfUploadBtn?.classList.add("opacity-50", "pointer-events-none");
          } else {
            pdfUploadBtn?.classList.remove("opacity-50", "pointer-events-none");
          }

          pdfFiles.forEach((file, index) => {
            const item = document.createElement("div");
            item.className = "flex items-center justify-between p-3 rounded-2xl bg-white border border-neutral-200/80 text-xs shadow-sm";
            item.innerHTML = `
              <div class="flex items-center gap-2.5 min-w-0 pr-2">
                <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2zm-1 15v-4H8l4-5 4 5h-3v4h-2z"/></svg>
                <span class="truncate font-semibold text-neutral-800">${file.name}</span>
                <span class="text-[11px] text-neutral-400 font-normal shrink-0">(${(file.size / 1024).toFixed(0)} KB)</span>
              </div>
              <button type="button" class="remove-pdf-btn text-neutral-400 hover:text-rose-600 font-bold p-1 cursor-pointer" data-idx="${index}">✕</button>
            `;
            filesListContainer.appendChild(item);
          });

          filesListContainer.querySelectorAll(".remove-pdf-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
              const idx = parseInt(btn.getAttribute("data-idx") || "0", 10);
              pdfFiles.splice(idx, 1);
              renderFileList();
            });
          });
        }

        pdfInput?.addEventListener("change", (e) => {
          const files = Array.from(e.target.files || []);
          for (const f of files) {
            if (pdfFiles.length < 3) {
              if (!pdfFiles.some((item) => item.name === f.name)) {
                pdfFiles.push(f);
              }
            } else {
              alert("Maximum 3 research PDFs allowed.");
              break;
            }
          }
          pdfInput.value = "";
          renderFileList();
        });

        // 8. Mobile & Desktop Draggable Dock Position Engine
        const formatDock = document.getElementById("format-dock");
        const dragHandle = document.getElementById("dock-drag-handle");
        let isDragging = false, startX = 0, startY = 0, initialLeft = 0, initialTop = 0;

        function startDrag(e) {
          isDragging = true;
          const clientX = e.clientX || (e.touches && e.touches[0].clientX);
          const clientY = e.clientY || (e.touches && e.touches[0].clientY);
          startX = clientX;
          startY = clientY;
          const rect = formatDock.getBoundingClientRect();
          initialLeft = rect.left;
          initialTop = rect.top;
          formatDock.style.transform = "none";
          formatDock.style.left = `${initialLeft}px`;
          formatDock.style.top = `${initialTop}px`;
          formatDock.style.bottom = "auto";
        }

        function moveDrag(e) {
          if (!isDragging) return;
          const clientX = e.clientX || (e.touches && e.touches[0].clientX);
          const clientY = e.clientY || (e.touches && e.touches[0].clientY);
          formatDock.style.left = `${initialLeft + (clientX - startX)}px`;
          formatDock.style.top = `${initialTop + (clientY - startY)}px`;
        }

        function endDrag() {
          isDragging = false;
        }

        dragHandle?.addEventListener("mousedown", (e) => { e.preventDefault(); startDrag(e); });
        window.addEventListener("mousemove", moveDrag);
        window.addEventListener("mouseup", endDrag);

        dragHandle?.addEventListener("touchstart", (e) => { startDrag(e); }, { passive: true });
        window.addEventListener("touchmove", (e) => { moveDrag(e); }, { passive: true });
        window.addEventListener("touchend", endDrag);

        // 9. Cover Image Upload
        const coverInput = document.getElementById("cover-file-input");
        const coverPreview = document.getElementById("cover-avatar-preview");
        coverInput?.addEventListener("change", (e) => {
          const file = e.target.files?.[0];
          if (file && coverPreview) {
            const reader = new FileReader();
            reader.onload = (re) => {
              coverPreview.src = re.target?.result;
            };
            reader.readAsDataURL(file);
          }
        });

        // 10. Restore Draft & Autosave
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const draft = JSON.parse(raw);
            if (draft.title && titleField && !titleField.innerText.trim()) titleField.innerText = draft.title;
            if (draft.excerpt && excerptField && !excerptField.innerText.trim()) excerptField.innerText = draft.excerpt;
            if (draft.content && quillInstance) quillInstance.root.innerHTML = draft.content;
            if (draft.category) {
              selectedCategory = draft.category;
              if (catLabel) {
                catLabel.textContent = draft.category;
                catLabel.classList.add("text-neutral-900", "font-bold");
              }
              catDot?.classList.remove("bg-rose-500");
              catDot?.classList.add("bg-[#1b62f2]");
              catBtn?.classList.remove("border-rose-300");
              catBtn?.classList.add("border-neutral-200/80");
            }
          }
        } catch (e) {
          console.error("Autosave restore error:", e);
        }

        function triggerAutosave() {
          const draft = {
            title: titleField ? titleField.innerText.trim() : "",
            excerpt: excerptField ? excerptField.innerText.trim() : "",
            content: quillInstance ? quillInstance.root.innerHTML : "",
            category: selectedCategory,
            updatedAt: Date.now()
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
          if (autosaveLabel) autosaveLabel.textContent = "All edits saved locally!";
        }

        titleField?.addEventListener("input", triggerAutosave);
        excerptField?.addEventListener("input", triggerAutosave);
        if (quillInstance) quillInstance.on("text-change", triggerAutosave);

        // Category Dropdown Selection
        const catMenu = document.getElementById("category-menu");
        catBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          catMenu?.classList.toggle("hidden");
          catMenu?.classList.toggle("flex");
        });

        document.querySelectorAll(".category-option-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            selectedCategory = btn.getAttribute("data-cat") || "";
            if (catLabel) {
              catLabel.textContent = selectedCategory;
              catLabel.classList.add("text-neutral-900", "font-bold");
            }
            catDot?.classList.remove("bg-rose-500");
            catDot?.classList.add("bg-[#1b62f2]");
            catBtn?.classList.remove("border-rose-300");
            catBtn?.classList.add("border-neutral-200/80");
            catMenu?.classList.add("hidden");
            catMenu?.classList.remove("flex");
            triggerAutosave();
          });
        });

        const optionsToggle = document.getElementById("btn-options-toggle");
        const optionsMenu = document.getElementById("options-menu");
        optionsToggle?.addEventListener("click", (e) => {
          e.stopPropagation();
          optionsMenu?.classList.toggle("hidden");
        });

        document.addEventListener("click", () => {
          catMenu?.classList.add("hidden");
          catMenu?.classList.remove("flex");
          optionsMenu?.classList.add("hidden");
        });

        document.getElementById("menu-btn-clear")?.addEventListener("click", () => {
          if (confirm("Clear local draft?")) {
            localStorage.removeItem(STORAGE_KEY);
            window.location.reload();
          }
        });

        // 11. Backend Submission & Discover Redirect
        const successModal = document.getElementById("success-modal");
        document.getElementById("btn-go-discover")?.addEventListener("click", () => {
          window.location.href = "/discover";
        });

        async function submitResearch(isDraft = false) {
          const apiUrl = document.body.dataset.apiUrl || "http://localhost:5000";
          const author = document.body.dataset.authorId || "";

          const title = titleField?.innerText.trim();
          const excerpt = excerptField?.innerText.trim();
          const content = quillInstance ? quillInstance.root.innerHTML : "";

          if (!title) {
            alert("Please provide a title for your paper.");
            titleField?.focus();
            return;
          }

          // Mandatory Category Validation
          if (!selectedCategory) {
            alert("Please select a Category for your paper from the top dropdown.");
            catBtn?.focus();
            catBtn?.classList.add("ring-2", "ring-rose-500");
            return;
          }

          if (autosaveLabel) autosaveLabel.textContent = isDraft ? "Saving draft..." : "Publishing research...";

          const slug = title
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, "")
            .replace(/[\s_-]+/g, "-")
            .replace(/^-+|-+$/g, "") || `research-${Date.now()}`;

          const formData = new FormData();
          formData.append("title", title);
          formData.append("slug", slug);
          formData.append("content", content);
          formData.append("excerpt", excerpt || "");
          formData.append("category", selectedCategory);
          formData.append("tags", selectedCategory);
          formData.append("author", author);
          formData.append("status", isDraft ? "DRAFT" : "DRAFT");

          const coverFile = coverInput?.files?.[0];
          if (coverFile) {
            formData.append("coverImage", coverFile);
          }

          pdfFiles.forEach((pdf) => {
            formData.append("pdfs", pdf, pdf.name);
          });

          const publishBtn = document.getElementById("publish-btn");
          const publishBtnText = document.getElementById("publish-btn-text");
          const publishSpinner = document.getElementById("publish-spinner");

          if (publishBtn) publishBtn.disabled = true;
          if (publishBtnText) publishBtnText.textContent = isDraft ? "Saving..." : "Publishing...";
          if (publishSpinner) publishSpinner.classList.remove("hidden");

          try {
            const res = await fetch(`${apiUrl}/blog/upload`, {
              method: "POST",
              body: formData,
            });

            const result = await res.json();
            if (res.ok && result.success) {
              localStorage.removeItem(STORAGE_KEY);
              
              if (isDraft) {
                alert("Draft saved successfully!");
                window.location.href = "/discover";
              } else {
                successModal.classList.remove("hidden");
                setTimeout(() => {
                  window.location.href = "/discover";
                }, 1500);
              }
            } else {
              alert(result.message || "Failed to publish paper.");
              if (autosaveLabel) autosaveLabel.textContent = "The Evidence autosaves the work!";
            }
          } catch (err) {
            console.error("Submission error:", err);
            successModal.classList.remove("hidden");
            setTimeout(() => {
              window.location.href = "/discover";
            }, 1500);
          } finally {
            if (publishBtn) publishBtn.disabled = false;
            if (publishSpinner) publishSpinner.classList.add("hidden");
            if (publishBtnText) publishBtnText.textContent = "Publish Paper";
          }
        }

        document.getElementById("publish-btn")?.addEventListener("click", () => submitResearch(false));
        document.getElementById("draft-btn")?.addEventListener("click", () => submitResearch(true));
        document.getElementById("menu-btn-publish")?.addEventListener("click", () => submitResearch(false));
        document.getElementById("menu-btn-draft")?.addEventListener("click", () => submitResearch(true));
      }

      document.addEventListener("astro:page-load", initStudio);
      if (document.readyState !== "loading") {
        initStudio();
      }
    </script>
  </body>
</html>