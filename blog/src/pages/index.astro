---
import Btn from "../components/Btn.tsx";
import Header from "../components/Header.astro";
import GridBackground from "../components/GridBackground.tsx";
import "../styles/globals.css";
import HeroSection from "../components/HeroSection";
import "lenis/dist/lenis.css";
import SmoothScrollInit from "../components/SmoothScrollInit";
import LatestBlogs from "../components/LatestBlogs.astro";
import FeatureBlocks from "../components/FeatureBlocks.astro";
import EditorialProcess from "../components/EditorialProcess.astro";
import CtaSection from "../components/CtaSection.astro";
import Footer from "../components/Footer.astro";
import AuthModalController from "../components/modals/AuthModalController.tsx";
import TokenLogger from "../components/token/TokenLogger.tsx";
import { ClientRouter } from "astro:transitions";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>The Evidence</title>
    <meta
      name="description"
      content="The Evidence - Read and discover insightful stories."
    />
    <script is:inline>
      const t =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", t === "dark");
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 selection:bg-blue-600 selection:text-white">
    <SmoothScrollInit client:load />
    <GridBackground client:load />
    <Header />
    <main class="flex flex-col min-h-screen items-center px-4 sm:px-6 lg:px-8">
      <HeroSection client:load />
      <LatestBlogs />
      <FeatureBlocks />
      <EditorialProcess />
      <CtaSection />
    </main>
    <Footer />
    <AuthModalController client:load />
    <TokenLogger client:load />
  </body>
</html>