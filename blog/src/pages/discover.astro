---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

const THE_EVIDENCE_LOGO =
  "https://pub-d65f9d792dba44cfb4b36fdd1925ed72.r2.dev/theevidence.png";
const GLOBE_THUMB =
  "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";

// Exact category list synchronized with your platform
const categoriesList = [
  "International Relations",
  "Diplomacy",
  "Public Policy",
  "Geopolitics",
  "Law & Governance",
  "Technology & Society",
  "Human Rights",
  "International Law",
  "Economic Partnerships",
  "Humanitarian Aid",
  "Crisis Management",
  "Risk Management",
  "Environmental Policy",
  "Global Security",
  "Macroeconomics",
  "General"
];

let papers: any[] = [];
let paginationMeta = {
  page: 1,
  totalPages: 1,
  totalBlogs: 0,
  hasMore: false,
};

let researchers: any[] = [];

const backendUri =
  import.meta.env.VITE_BACKEND_URI ||
  import.meta.env.PUBLIC_BACKEND_URI ||
  "http://localhost:5000";

// Helper function to format view counts cleanly
function formatViewCount(num: number): string {
  if (num >= 1000000) {
    return `${(num / 1000000).toFixed(1)}M+ views`;
  }
  if (num >= 1000) {
    return `${(num / 1000).toFixed(1)}k+ views`;
  }
  return `${num} views`;
}

try {
  const res = await fetch(`${backendUri}/blog/published?page=1&limit=100`, {
    headers: { Accept: "application/json" },
  });

  if (res.ok) {
    const data = await res.json();
    const rawList = data.blogs || data.papers || (Array.isArray(data) ? data : []);

    if (Array.isArray(rawList)) {
      if (data.pagination) {
        paginationMeta = data.pagination;
      }

      papers = rawList.map((b: any, idx: number) => {
        const rawExcerpt = b.excerpt || "";
        let cleanExcerpt = rawExcerpt;
        if (!cleanExcerpt && b.content) {
          const textOnly = b.content.replace(/<[^>]*>/g, "").trim();
          cleanExcerpt = textOnly.length > 150 ? textOnly.substring(0, 150) + "..." : textOnly;
        }
        const finalExcerpt = cleanExcerpt || "Read the full publication for more details.";

        const readMinutes = Math.max(
          1,
          Math.ceil((finalExcerpt.length || 500) / 400),
        );

        const rawType = String(b.docType || b.type || "").trim().toUpperCase();
        const finalDocType = rawType.includes("BLOG") || rawType.includes("THOUGHT") ? "BLOG" : "RESEARCH";

        const authorObj = b.author || {};
        const authorName = authorObj.name || "Researcher";
        const authorAvatar = authorObj.avatar || "";
        const viewNum = Number(b.views) || 0;

        return {
          id: b._id || idx,
          title: b.title || "Untitled Document",
          category: b.category || "General",
          summary: finalExcerpt,
          authorName: authorName,
          authorId: authorObj._id || authorObj || "",
          authorAvatar: authorAvatar,
          docType: finalDocType,
          publishedDate:
            b.publishedAt || b.createdAt
              ? new Date(b.publishedAt || b.createdAt).toLocaleDateString(
                  "en-US",
                  { month: "short", day: "numeric", year: "numeric" },
                )
              : "Sep 7, 2026",
          rawTimestamp:
            b.publishedAt || b.createdAt
              ? new Date(b.publishedAt || b.createdAt).getTime()
              : 0,
          views: viewNum,
          viewsCount: formatViewCount(viewNum),
          readTimeMinutes: readMinutes,
          readTime: `${readMinutes} min read`,
          thumbnail: b.coverImage?.url || GLOBE_THUMB,
          slug: b.slug,
          pdfs: b.pdfs || [],
        };
      });
    }
  }
} catch (e) {
  console.error("Error fetching published documents:", e);
}

// Fallback preview items if database is completely empty
if (papers.length === 0) {
  papers = Array.from({ length: 6 }).map((_, i) => ({
    id: i + 1,
    title: i % 2 === 0 ? "AI Ethics: Navigating the Moral Landscape of Machine Learning" : "The Future of Digital Diplomacy in a Multipolar World",
    category: categoriesList[i % categoriesList.length],
    summary: "An examination of how emerging digital technologies and policy shifts are reshaping global practices.",
    authorName: i % 2 === 0 ? "Dr. Emily Tran" : "Dr. Sarah Mitchell",
    authorId: `fallback-author-${i}`,
    authorAvatar: "",
    docType: i % 2 === 0 ? "BLOG" : "RESEARCH",
    publishedDate: "Oct 5, 2026",
    rawTimestamp: Date.now() - i * 86400000,
    views: 45300 - i * 1200,
    viewsCount: "45.3k views",
    readTimeMinutes: 10,
    readTime: "10 min read",
    thumbnail: GLOBE_THUMB,
    slug: `document-slug-${i + 1}`,
  }));
}

// Build Top Researchers from actual paper views (aggregate per author)
try {
  const authorAgg: Record<
    string,
    { name: string; authorId: string; avatar: string; totalViews: number }
  > = {};

  papers.forEach((p) => {
    const key = p.authorId || p.authorName;
    if (!authorAgg[key]) {
      authorAgg[key] = {
        name: p.authorName,
        authorId: p.authorId,
        avatar: p.authorAvatar,
        totalViews: 0,
      };
    }
    authorAgg[key].totalViews += Number(p.views) || 0;
    if (!authorAgg[key].avatar && p.authorAvatar) {
      authorAgg[key].avatar = p.authorAvatar;
    }
  });

  researchers = Object.values(authorAgg)
    .sort((a, b) => b.totalViews - a.totalViews)
    .slice(0, 100)
    .map((r) => ({
      name: r.name,
      authorId: r.authorId,
      avatarUrl: r.avatar,
      views: r.totalViews,
      viewsLabel: formatViewCount(r.totalViews),
    }));
} catch (e) {
  console.error("Error aggregating researcher views:", e);
}

if (researchers.length === 0) {
  researchers = [
    { name: "Divyesh Moraniya", authorId: "", views: 2347700, viewsLabel: "2.2M+ views", avatarUrl: "" },
    { name: "Test User", authorId: "", views: 1265300, viewsLabel: "1.3M+ views", avatarUrl: "" },
    { name: "Viral Vaghela", authorId: "", views: 19, viewsLabel: "29 views", avatarUrl: "" },
  ];
}

// Count categories
const categoryCounts: Record<string, number> = {};
categoriesList.forEach((c) => {
  categoryCounts[c] = 0;
});
papers.forEach((p) => {
  const cat = categoriesList.includes(p.category) ? p.category : "General";
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
