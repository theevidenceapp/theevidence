---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

const THE_EVIDENCE_LOGO = "https://pub-d65f9d792dba44cfb4b36fdd1925ed72.r2.dev/theevidence.png";
const GLOBE_THUMB = "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";

// Exact category list synchronized with new.astro
const categoriesList = [
  "International Relations",
  "Diplomacy",
  "Public Policy",
  "Geopolitics",
  "Law & Governance",
  "Technology & Society",
  "Human Rights",
  "International Law",
  "Economic Partnerships",
  "Humanitarian Aid",
  "Crisis Management",
  "Risk Management",
  "Environmental Policy",
  "Global Security",
  "Macroeconomics"
];

let papers: any[] = [];
let paginationMeta = {
  page: 1,
  totalPages: 1,
  totalBlogs: 0,
  hasMore: false,
};

let researchers: any[] = [
  { name: "Dr. Sarah Mitchell", views: "28.7k views" },
  { name: "Johnathan Lee", views: "15.2k views" },
  { name: "Angela Ramirez", views: "32.5k views" },
  { name: "Michael Chen", views: "20.1k views" },
  { name: "Jennifer Kim", views: "14.8k views" },
  { name: "Robert Johnson", views: "18.3k views" },
  { name: "Emily Davis", views: "25.6k views" },
  { name: "David Martinez", views: "22.4k views" },
  { name: "Sophia Patel", views: "30.2k views" },
  { name: "Matthew Brown", views: "29.0k views" },
];

const backendUri = import.meta.env.VITE_BACKEND_URI || import.meta.env.PUBLIC_BACKEND_URI || "http://localhost:5000";

try {
  // Request page 1 with 12 items
  const blogsRes = await fetch(`${backendUri}/blog/published?page=1&limit=12`, {
    headers: { "Accept": "application/json" }
  });
  
  if (blogsRes.ok) {
    const data = await blogsRes.json();
    if (data.success && Array.isArray(data.blogs)) {
      if (data.pagination) {
        paginationMeta = data.pagination;
      }
      papers = data.blogs.map((b: any) => {
        const rawExcerpt = b.excerpt || "";
        const readMinutes = Math.max(1, Math.ceil((rawExcerpt.length || 500) / 400));
        
        return {
          id: b._id,
          title: b.title || "Untitled Research Paper",
          category: b.category || "International Relations",
          summary: rawExcerpt || "No abstract provided for this paper.",
          authorName: b.author?.name || "Researcher",
          authorAvatar: b.author?.avatar || "",
          publishedDate: b.publishedAt || b.createdAt
            ? new Date(b.publishedAt || b.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
            : "Aug 20, 2026",
          rawTimestamp: b.publishedAt || b.createdAt ? new Date(b.publishedAt || b.createdAt).getTime() : 0,
          views: Number(b.views) || 0,
          viewsCount: `${b.views ?? 0} views`,
          readTimeMinutes: readMinutes,
          readTime: `${readMinutes} min read`,
          thumbnail: b.coverImage?.url || GLOBE_THUMB,
          slug: b.slug,
          pdfs: b.pdfs || []
        };
      });
    }
  }
} catch (e) {
  console.error("Error fetching published blogs:", e);
}

// Fallback preview papers if database is empty
if (papers.length === 0) {
  papers = Array.from({ length: 6 }).map((_, i) => ({
    id: i + 1,
    title: "The Future of Digital Diplomacy in a Multipolar World",
    category: categoriesList[i % categoriesList.length],
    summary: "An examination of how emerging digital technologies are reshaping diplomatic practices, international cooperation, and geopolitical communication.",
    authorName: "Dr. Sarah Mitchell",
    authorAvatar: "",
    publishedDate: "Aug 20, 2026",
    rawTimestamp: Date.now() - i * 86400000,
    views: 28700 - i * 1200,
    viewsCount: `${(28.7 - i * 1.2).toFixed(1)}k views`,
    readTimeMinutes: 12 - i,
    readTime: `${12 - i} min read`,
    thumbnail: GLOBE_THUMB,
    slug: `future-of-digital-diplomacy-${i + 1}`
  }));
}

// Count categories
const categoryCounts: Record<string, number> = {};
categoriesList.forEach((c) => { categoryCounts[c] = 0; });
papers.forEach((p) => {
  if (categoryCounts[p.category] !== undefined) {
    categoryCounts[p.category]++;
  }
});
---

<!doctype html>
<html lang="en" class="bg-[#f9f9fb]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <ClientRouter />
    <title>The Evidence - Discover</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin>

    <style>
      html, body {
        background-color: #f9f9fb !important;
        -webkit-tap-highlight-color: transparent;
      }
      .no-scroll::-webkit-scrollbar { display: none; }
      .no-scroll { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
  </head>
  <body
    class="bg-[#f9f9fb] text-[#111] antialiased h-screen w-screen overflow-hidden flex flex-col m-0 p-0 font-sans select-none relative"
    data-backend-uri={backendUri}
    data-total-pages={paginationMeta.totalPages}
    data-current-page={paginationMeta.page}
    data-has-more={paginationMeta.hasMore ? "true" : "false"}
  >
    
    <!-- DESKTOP HOVER DRAWER SIDEBAR -->
    <aside
      class="hidden md:flex group absolute top-0 left-0 bottom-0 z-50 w-[74px] hover:w-[220px] bg-[#f9f9fb] hover:shadow-[10px_0_30px_rgba(0,0,0,0.06)] transition-all duration-300 ease-in-out flex-col items-start px-3.5 py-6 shrink-0"
    >
      <a href="/" class="flex items-center h-[56px] px-1 mb-6 overflow-hidden shrink-0 w-full" title="The Evidence">
        <img
          src={THE_EVIDENCE_LOGO}
          alt="The Evidence"
          class="h-12 w-auto max-w-none object-contain shrink-0"
        />
      </a>

      <nav class="flex flex-col gap-3.5 w-full">
        <!-- Discover -->
        <a
          href="/discover"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full bg-[#e8f0fe] text-[#0d0d0c] transition-all duration-300 overflow-hidden"
          title="Discover"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0">
              <path d="M4.31802 19.682C3 18.364 3 16.2426 3 12C3 7.75736 3 5.63604 4.31802 4.31802C5.63604 3 7.75736 3 12 3C16.2426 3 18.364 3 19.682 4.31802C21 5.63604 21 7.75736 21 12C21 16.2426 21 18.364 19.682 19.682C18.364 21 16.2426 21 12 21C7.75736 21 5.63604 21 4.31802 19.682Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 14L9.79289 11.2071C10.1834 10.8166 10.8166 10.8166 11.2071 11.2071L12.7929 12.7929C13.1834 13.1834 13.8166 13.1834 14.2071 12.7929L17 10" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Discover
          </span>
        </a>

        <!-- Desk -->
        <a
          href="/desk"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Desk"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0">
              <path d="M10.5502 3C6.69782 3.00694 4.6805 3.10152 3.39128 4.39073C2 5.78202 2 8.02125 2 12.4997C2 16.9782 2 19.2174 3.39128 20.6087C4.78257 22 7.0218 22 11.5003 22C15.9787 22 18.218 22 19.6093 20.6087C20.8985 19.3195 20.9931 17.3022 21 13.4498" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M11.0557 13C10.3323 3.86635 16.8024 1.27554 21.9806 2.16439C22.1897 5.19136 20.7086 6.32482 17.888 6.84825C18.4327 7.41736 19.3951 8.13354 19.2913 9.02879C19.2174 9.66586 18.7847 9.97843 17.9195 10.6036C16.0232 11.9736 13.8265 12.8375 11.0557 13Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 17C11 11.5 12.9604 9.63636 15 8" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Desk
          </span>
        </a>

        <!-- Notification -->
        <a
          href="/notification"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Notification"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0">
              <path d="M15.5 18C15.5 19.933 13.933 21.5 12 21.5C10.067 21.5 8.5 19.933 8.5 18" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19.2311 18H4.76887C3.79195 18 3 17.208 3 16.2311C3 15.762 3.18636 15.3121 3.51809 14.9803L4.12132 14.3771C4.68393 13.8145 5 13.0514 5 12.2558V9.5C5 5.63401 8.13401 2.5 12 2.5C15.866 2.5 19 5.634 19 9.5V12.2558C19 13.0514 19.3161 13.8145 19.8787 14.3771L20.4819 14.9803C20.8136 15.3121 21 15.762 21 16.2311C21 17.208 20.208 18 19.2311 18Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 9C21.2088 9 23 7.2088 23 5C23 2.7904 21.2088 1 19 1C16.7912 1 15 2.7904 15 5C15 7.2088 16.7912 9 19 9Z" fill="#2563EB"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Notification
          </span>
        </a>

        <!-- Account -->
        <a
          href="/account"
          class="flex items-center h-11 w-11 group-hover:w-full rounded-full text-[#0d0d0c] hover:bg-[#e8f0fe] transition-all duration-300 overflow-hidden"
          title="Account"
        >
          <div class="w-11 h-11 shrink-0 flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0">
              <path d="M18.4984 19.1511C17.3377 17.4018 15.2947 16.2009 12.9313 16.0569L11.9984 16C11.6652 16.0083 11.3547 16.0194 11.0617 16.0325C8.71722 16.1376 6.66598 17.3796 5.5 19.1511" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14.9961 10C14.9961 11.6569 13.6529 13 11.9961 13C10.3392 13 8.99609 11.6569 8.99609 10C8.99609 8.34315 10.3392 7 11.9961 7C13.6529 7 14.9961 8.34315 14.9961 10Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#0D0D0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-medium text-[#0d0d0c] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pl-1 pr-4">
            Account
          </span>
        </a>
      </nav>
    </aside>

    <!-- Top Header -->
    <header class="h-[68px] sm:h-[76px] px-4 md:pl-[90px] md:pr-8 flex items-center justify-between shrink-0 z-20 bg-[#f9f9fb]">
      <a href="/" class="flex md:hidden items-center shrink-0 mr-3" title="The Evidence">
        <img src={THE_EVIDENCE_LOGO} alt="The Evidence" class="h-8 w-auto object-contain" />
      </a>

      <div class="hidden lg:block w-[180px]"></div>

      <!-- Search Input -->
      <div class="flex-1 max-w-[560px]">
        <div class="relative w-full">
          <svg class="w-4 h-4 absolute left-3.5 sm:left-4 top-1/2 -translate-y-1/2 text-[#666]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="global-search-input"
            placeholder="Search research paper/researcher..."
            class="w-full pl-10 sm:pl-11 pr-4 py-2 sm:py-2.5 text-[12.5px] sm:text-[13px] bg-white text-[#111] placeholder-[#777] rounded-full border border-neutral-200/50 shadow-[0_1px_3px_rgba(0,0,0,0.02)] focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all"
          />
        </div>
      </div>

      <div class="hidden lg:block w-[180px]"></div>
    </header>

    <!-- MOBILE QUICK ACCESS ACTION BADGES -->
    <div class="flex md:hidden items-center justify-center gap-3 px-4 pb-2 shrink-0">
      <button
        type="button"
        id="open-areas-modal"
        class="flex-1 py-2 px-3 bg-white border border-neutral-200/60 rounded-full text-xs font-medium text-neutral-800 shadow-sm flex items-center justify-center gap-1.5 active:bg-neutral-50 cursor-pointer"
      >
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        <span id="mobile-area-btn-label">Explore Areas</span>
      </button>

      <button
        type="button"
        id="open-researchers-modal"
        class="flex-1 py-2 px-3 bg-white border border-neutral-200/60 rounded-full text-xs font-medium text-neutral-800 shadow-sm flex items-center justify-center gap-1.5 active:bg-neutral-50 cursor-pointer"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Top Researchers</span>
      </button>
    </div>

    <!-- Main Viewport Area -->
    <div class="flex-1 flex px-4 sm:px-6 md:pl-[90px] md:pr-8 pb-20 md:pb-6 pt-0 gap-5 lg:gap-7 overflow-hidden max-w-[1600px] w-full mx-auto">
      
      <!-- 3-Column Desktop Stage -->
      <div class="flex-1 flex gap-5 lg:gap-7 overflow-hidden">
        
        <!-- COLUMN 1: Research Areas (Desktop) -->
        <div class="hidden md:flex w-[220px] lg:w-[245px] shrink-0 flex-col items-center h-full">
          <div class="w-full flex items-center justify-between mb-3 px-1">
            <h2 class="text-[14px] font-bold text-[#111] tracking-tight">Research Areas</h2>
            <button
              type="button"
              id="btn-clear-area-filter"
              class="hidden text-[11px] font-bold text-[#1b62f2] hover:underline cursor-pointer"
            >
              Reset
            </button>
          </div>
          
          <div class="w-full relative mb-3 shrink-0">
            <svg class="w-3.5 h-3.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#777]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="area-search-input"
              placeholder="Filter research area..."
              class="w-full pl-9 pr-3 py-2 text-[12px] bg-white placeholder-[#777] rounded-full border border-neutral-200/50 shadow-[0_1px_2px_rgba(0,0,0,0.02)] focus:outline-none focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div id="areas-list" class="w-full flex-1 overflow-y-auto no-scroll flex flex-col gap-1.5 py-0.5">
            {categoriesList.map((catName) => (
              <button
                type="button"
                class="area-item w-full flex items-center justify-between px-3.5 py-2.5 bg-white hover:bg-[#e8f0fe] hover:text-[#1b62f2] rounded-2xl text-[12px] text-[#222] transition-colors border border-neutral-200/40 shadow-[0_1px_2px_rgba(0,0,0,0.02)] shrink-0 group cursor-pointer text-left"
                data-category={catName}
              >
                <span class="truncate font-medium">{catName}</span>
                <span class="text-[11px] text-[#888] group-hover:text-[#1b62f2] shrink-0 ml-1.5 font-normal transition-colors">
                  {categoryCounts[catName] || 0}
                </span>
              </button>
            ))}
          </div>
        </div>

        <!-- COLUMN 2: Cards Feed & Dynamic Interactive Filter -->
        <main class="flex-1 h-full overflow-y-auto no-scroll pr-0.5 sm:pr-1 flex flex-col gap-3.5">
          
          <!-- Interactive Filter Tabs -->
          <div class="sticky top-0 z-10 pb-2 pt-0.5 bg-[#f9f9fb]/95 backdrop-blur-sm flex items-center overflow-x-auto no-scroll justify-start sm:justify-center gap-2 sm:gap-2.5 shrink-0 px-1">
            
            <button
              type="button"
              data-filter="all"
              class="filter-tab px-4 sm:px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal transition-all whitespace-nowrap shrink-0 cursor-pointer bg-[#1b62f2] text-white shadow-[0_2px_8px_rgba(27,98,242,0.25)] border border-transparent"
            >
              All
            </button>

            <button
              type="button"
              data-filter="recent"
              class="filter-tab px-4 sm:px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal transition-all whitespace-nowrap shrink-0 cursor-pointer bg-white text-[#1a1a1a] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] active:scale-95"
            >
              Most recent
            </button>

            <button
              type="button"
              data-filter="views"
              class="filter-tab px-4 sm:px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal transition-all whitespace-nowrap shrink-0 cursor-pointer bg-white text-[#1a1a1a] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] active:scale-95"
            >
              Most viewed
            </button>

            <button
              type="button"
              data-filter="readtime"
              class="filter-tab px-4 sm:px-5 h-[34px] sm:h-[36px] flex items-center justify-center rounded-full text-[12.5px] sm:text-[13px] font-normal transition-all whitespace-nowrap shrink-0 cursor-pointer bg-white text-[#1a1a1a] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] active:scale-95"
            >
              Least read time
            </button>

          </div>

          <!-- Active Category Indicator Badge -->
          <div id="active-category-pill" class="hidden items-center justify-between px-4 py-2 bg-blue-50 border border-blue-200 rounded-2xl text-xs text-[#1b62f2] shrink-0">
            <div class="flex items-center gap-1.5 font-bold">
              <span>Category:</span>
              <span id="active-category-name" class="underline">None</span>
            </div>
            <button type="button" id="btn-dismiss-category-pill" class="font-bold text-neutral-500 hover:text-rose-600 px-1">✕</button>
          </div>

          <!-- Cards Feed -->
          <div id="papers-feed" class="flex flex-col gap-3.5">
            {papers.map((item: any, idx: number) => (
              <a
                href={`/papers/${item.slug || item.id}`}
                data-astro-prefetch="viewport"
                class="paper-card bg-white rounded-[20px] sm:rounded-[24px] p-4 sm:p-6 border border-neutral-200/40 shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-3 sm:gap-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_16px_rgba(0,0,0,0.05)] cursor-pointer group"
                data-original-index={idx}
                data-timestamp={item.rawTimestamp || 0}
                data-views={item.views || 0}
                data-readtime={item.readTimeMinutes || 1}
                data-category={item.category || ""}
                data-title={item.title ? item.title.toLowerCase() : ""}
                data-author={item.authorName ? item.authorName.toLowerCase() : ""}
              >
                
                <div class="flex items-start gap-3.5 sm:gap-4">
                  <img
                    src={item.thumbnail || GLOBE_THUMB}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="w-[60px] h-[60px] sm:w-[74px] sm:h-[74px] rounded-xl sm:rounded-2xl object-cover shrink-0 bg-[#0f172a] border border-neutral-100"
                  />
                  <div class="flex flex-col pt-0.5 min-w-0">
                    <span class="text-[11px] sm:text-[12px] text-[#6b7280] font-normal leading-none truncate">{item.category}</span>
                    <h3 class="text-[15px] sm:text-[17px] font-bold text-[#111] group-hover:text-[#1b62f2] leading-[1.3] sm:leading-[1.25] tracking-tight mt-1 sm:mt-1.5 line-clamp-2 transition-colors">
                      {item.title}
                    </h3>
                  </div>
                </div>

                <p class="text-[12.5px] sm:text-[13.5px] text-[#222] leading-[1.45] line-clamp-3">
                  {item.summary}
                </p>

                <div class="flex items-center gap-3 sm:gap-5 text-[11px] sm:text-[12px] text-[#6b7280] pt-1 flex-wrap font-normal">
                  <div class="flex items-center gap-1.5 text-[#4b5563]">
                    <div class="w-4 h-4 rounded-full bg-[#d8d8d8] overflow-hidden flex items-center justify-center shrink-0 text-[9px] font-bold text-neutral-600">
                      {item.authorAvatar ? (
                        <img src={item.authorAvatar} alt="" class="w-full h-full object-cover" />
                      ) : (
                        item.authorName?.charAt(0) || "R"
                      )}
                    </div>
                    <span class="truncate max-w-[110px] sm:max-w-none font-medium text-neutral-800">{item.authorName}</span>
                  </div>

                  <div class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#888]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
