                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Client Script -->
    <script>
      function initDiscover() {
        const backendUri =
          document.body.getAttribute("data-backend-uri") ||
          "http://localhost:5000";
        let currentPage =
          Number(document.body.getAttribute("data-current-page")) || 1;
        let totalPages =
          Number(document.body.getAttribute("data-total-pages")) || 1;
        let hasMore = document.body.getAttribute("data-has-more") === "true";
        let isLoading = false;

        const filterTabs = document.querySelectorAll(".filter-tab");
        const papersFeed = document.getElementById("papers-feed");
        const feedLoadingOverlay = document.getElementById("feed-loading-overlay");
        const globalSearch = document.getElementById(
          "global-search-input",
        ) as HTMLInputElement;
        const areaButtons = document.querySelectorAll(
          ".area-item, .mobile-area-item",
        );
        const clearAreaBtn = document.getElementById("btn-clear-area-filter");
        const activeCategoryPill = document.getElementById(
          "active-category-pill",
        );
        const activeCategoryName = document.getElementById(
          "active-category-name",
        );
        const dismissPillBtn = document.getElementById(
          "btn-dismiss-category-pill",
        );
        const activeResearcherPill = document.getElementById(
          "active-researcher-pill",
        );
        const activeResearcherName = document.getElementById(
          "active-researcher-name",
        );
        const dismissResearcherPillBtn = document.getElementById(
          "btn-dismiss-researcher-pill",
        );
        const noPapersMsg = document.getElementById("no-papers-msg");
        const mobileAreaLabel = document.getElementById(
          "mobile-area-btn-label",
        );

        const loadMoreBtn = document.getElementById("btn-load-more");
        const loadMoreText = document.getElementById("load-more-text");
        const loadMoreSpinner = document.getElementById("load-more-spinner");
        const allLoadedMsg = document.getElementById("all-loaded-msg");

        const doctypeTabs = document.querySelectorAll(
          ".doctype-tab, .doctype-tab-mobile",
        );

        let activeCategory = "";
        let currentSort = "all";
        let activeDocType = "RESEARCH";
        let activeAuthorId = "";
        let activeAuthorName = "";

        function showLoadingOverlay() {
          if (feedLoadingOverlay) {
            feedLoadingOverlay.classList.remove("hidden");
            feedLoadingOverlay.classList.add("flex");
          }
        }

        function hideLoadingOverlay() {
          if (feedLoadingOverlay) {
            feedLoadingOverlay.classList.add("hidden");
            feedLoadingOverlay.classList.remove("flex");
          }
        }

        function applyFilters() {
          const query = globalSearch
            ? globalSearch.value.toLowerCase().trim()
            : "";
          const cards = document.querySelectorAll(".paper-card");
          let visibleCount = 0;

          cards.forEach((c) => {
            const card = c as HTMLElement;
            const title = card.dataset.title || "";
            const author = card.dataset.author || "";
            const category = card.dataset.category || "";
            const docType = (card.dataset.doctype || "RESEARCH").toUpperCase();
            const authorId = card.dataset.authorId || "";
            const textContent = card.innerText.toLowerCase();

            const matchesSearch =
              !query ||
              title.includes(query) ||
              author.includes(query) ||
              textContent.includes(query);
            const matchesCategory =
              !activeCategory ||
              category.toLowerCase() === activeCategory.toLowerCase();
            const matchesDocType = docType === activeDocType;
            const matchesAuthor =
              !activeAuthorId ||
              authorId === activeAuthorId ||
              (author && activeAuthorName && author === activeAuthorName.toLowerCase());

            if (
              matchesSearch &&
              matchesCategory &&
              matchesDocType &&
              matchesAuthor
            ) {
              card.style.display = "flex";
              visibleCount++;
            } else {
              card.style.display = "none";
            }
          });

          if (noPapersMsg) {
            noPapersMsg.style.display = visibleCount === 0 ? "flex" : "none";
          }
        }

        function applySort() {
          if (!papersFeed) return;
          const cards = Array.from(papersFeed.querySelectorAll(".paper-card"));

          cards.sort((a, b) => {
            const cardA = a as HTMLElement;
            const cardB = b as HTMLElement;

            if (currentSort === "recent") {
              return (
                Number(cardB.dataset.timestamp || 0) -
                Number(cardA.dataset.timestamp || 0)
              );
            } else if (currentSort === "views") {
              return (
                Number(cardB.dataset.views || 0) -
                Number(cardA.dataset.views || 0)
              );
            } else if (currentSort === "readtime") {
              return (
                Number(cardA.dataset.readtime || 0) -
                Number(cardB.dataset.readtime || 0)
              );
            } else {
              return (
                Number(cardA.dataset.originalIndex || 0) -
                Number(cardB.dataset.originalIndex || 0)
              );
            }
          });

          cards.forEach((card) => papersFeed.appendChild(card));
        }

        function setDocType(docType: string) {
          activeDocType = docType.toUpperCase();
          showLoadingOverlay();

          setTimeout(() => {
            doctypeTabs.forEach((tab) => {
              const tabType = tab.getAttribute("data-doctype");
              const isMobile = tab.classList.contains("doctype-tab-mobile");

              if (tabType === activeDocType) {
                tab.classList.add(
                  "bg-[#1b62f2]",
                  "text-white",
                  "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
                );
                tab.classList.remove("text-[#555]", "hover:text-[#1b62f2]");
              } else {
                tab.classList.remove(
                  "bg-[#1b62f2]",
                  "text-white",
                  "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
                );
                tab.classList.add("text-[#555]");
                if (!isMobile) tab.classList.add("hover:text-[#1b62f2]");
              }
            });

            applyFilters();
            applySort();
            hideLoadingOverlay();
          }, 250);
        }

        doctypeTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const docType = tab.getAttribute("data-doctype") || "RESEARCH";
            setDocType(docType);
          });
        });

        function setCategory(catName: string) {
          activeCategory = activeCategory === catName ? "" : catName;

          areaButtons.forEach((btn) => {
            const btnCat = btn.getAttribute("data-category");
            if (
              activeCategory &&
              btnCat?.toLowerCase() === activeCategory.toLowerCase()
            ) {
              btn.classList.add(
                "bg-[#e8f0fe]",
                "text-[#1b62f2]",
                "border-[#1b62f2]",
              );
            } else {
              btn.classList.remove(
                "bg-[#e8f0fe]",
                "text-[#1b62f2]",
                "border-[#1b62f2]",
              );
            }
          });

          if (activeCategory) {
            clearAreaBtn?.classList.remove("hidden");
            if (activeCategoryPill && activeCategoryName) {
              activeCategoryName.textContent = activeCategory;
              activeCategoryPill.classList.remove("hidden");
              activeCategoryPill.classList.add("flex");
            }
            if (mobileAreaLabel) mobileAreaLabel.textContent = activeCategory;
          } else {
            clearAreaBtn?.classList.add("hidden");
            activeCategoryPill?.classList.add("hidden");
            activeCategoryPill?.classList.remove("flex");
            if (mobileAreaLabel) mobileAreaLabel.textContent = "Specific research area";
          }

          applyFilters();
        }

        areaButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const cat = btn.getAttribute("data-category") || "";
            setCategory(cat);

            const modalAreas = document.getElementById("modal-areas");
            modalAreas?.classList.add("hidden");
            modalAreas?.classList.remove("flex");
          });
        });

        clearAreaBtn?.addEventListener("click", () => setCategory(""));
        dismissPillBtn?.addEventListener("click", () => setCategory(""));

        function setResearcher(authorId: string, authorName: string) {
          const isSame =
            activeAuthorId === authorId || activeAuthorName === authorName;
          if (isSame && activeAuthorId) {
            activeAuthorId = "";
            activeAuthorName = "";
          } else {
            activeAuthorId = authorId;
            activeAuthorName = authorName;
          }

          document
            .querySelectorAll(".researcher-item, .mobile-researcher-item")
            .forEach((item) => {
              const itemAuthorId = item.getAttribute("data-author-id") || "";
              const itemAuthorName =
                item.getAttribute("data-author-name") || "";
              const matches =
                activeAuthorId &&
                (itemAuthorId === activeAuthorId ||
                  itemAuthorName === activeAuthorName);

              if (matches) {
                item.classList.add("bg-[#e8f0fe]");
              } else {
                item.classList.remove("bg-[#e8f0fe]");
              }
            });

          if (activeAuthorName) {
            if (activeResearcherPill && activeResearcherName) {
              activeResearcherName.textContent = activeAuthorName;
              activeResearcherPill.classList.remove("hidden");
              activeResearcherPill.classList.add("flex");
            }
          } else {
            activeResearcherPill?.classList.add("hidden");
            activeResearcherPill?.classList.remove("flex");
          }

          applyFilters();
        }

        document
          .querySelectorAll(".researcher-item, .mobile-researcher-item")
          .forEach((item) => {
            item.addEventListener("click", () => {
              const authorId = item.getAttribute("data-author-id") || "";
              const authorName = item.getAttribute("data-author-name") || "";
              setResearcher(authorId, authorName);

              const modalResearchers = document.getElementById(
                "modal-researchers",
              );
              modalResearchers?.classList.add("hidden");
              modalResearchers?.classList.remove("flex");
            });
          });

        dismissResearcherPillBtn?.addEventListener("click", () =>
          setResearcher("", ""),
        );

        filterTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            currentSort = tab.getAttribute("data-filter") || "all";

            filterTabs.forEach((t) => {
              t.classList.remove(
                "bg-[#1b62f2]",
                "text-white",
                "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
                "border-transparent",
              );
              t.classList.add(
                "bg-white",
                "text-[#1a1a1a]",
                "hover:bg-[#e8f0fe]",
                "hover:text-[#1b62f2]",
                "border-neutral-200/60",
              );
            });

            tab.classList.remove(
              "bg-white",
              "text-[#1a1a1a]",
              "hover:bg-[#e8f0fe]",
              "hover:text-[#1b62f2]",
              "border-neutral-200/60",
            );
            tab.classList.add(
              "bg-[#1b62f2]",
              "text-white",
              "shadow-[0_2px_8px_rgba(27,98,242,0.25)]",
              "border-transparent",
            );

            applySort();
          });
        });

        globalSearch?.addEventListener("input", applyFilters);

        const searchInput = document.getElementById(
          "area-search-input",
        ) as HTMLInputElement;
        searchInput?.addEventListener("input", (e) => {
          const query = (e.target as HTMLInputElement).value.toLowerCase();
          document.querySelectorAll(".area-item").forEach((item) => {
            const textContent = item.textContent?.toLowerCase() || "";
            (item as HTMLElement).style.display = textContent.includes(query)
              ? "flex"
              : "none";
          });
        });

        async function loadNextPage() {
          if (isLoading || !hasMore) return;
          isLoading = true;

          if (loadMoreSpinner) loadMoreSpinner.classList.remove("hidden");
          if (loadMoreText) loadMoreText.textContent = "Loading...";

          try {
            const nextPage = currentPage + 1;
            const res = await fetch(
              `${backendUri}/blog/published?page=${nextPage}&limit=50`,
              {
                headers: { Accept: "application/json" },
              },
            );
            const data = await res.json();

            if (res.ok && data.success && Array.isArray(data.blogs)) {
              if (data.blogs.length === 0) {
                hasMore = false;
              } else {
                currentPage = nextPage;
                totalPages = data.pagination?.totalPages || totalPages;
                hasMore = data.pagination?.hasMore ?? currentPage < totalPages;

                const baseIndex = (currentPage - 1) * 50;

                data.blogs.forEach((b: any, index: number) => {
                  const rawExcerpt = b.excerpt || "";
                  let cleanExcerpt = rawExcerpt;
                  if (!cleanExcerpt && b.content) {
                    const textOnly = b.content.replace(/<[^>]*>/g, "").trim();
                    cleanExcerpt = textOnly.length > 150 ? textOnly.substring(0, 150) + "..." : textOnly;
                  }
                  const finalExcerpt = cleanExcerpt || "Read the full publication for more details.";

                  const readMinutes = Math.max(
                    1,
                    Math.ceil((finalExcerpt.length || 500) / 400),
                  );
                  const pubDate =
                    b.publishedAt || b.createdAt
                      ? new Date(
                          b.publishedAt || b.createdAt,
                        ).toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })
                      : "Aug 20, 2026";
                  const thumb =
                    b.coverImage?.url ||
                    "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";
                  
                  const rawType = String(b.docType || b.type || "").trim().toUpperCase();
                  const docType = rawType.includes("BLOG") || rawType.includes("THOUGHT") ? "BLOG" : "RESEARCH";
                  const authorId = b.author?._id || b.author || "";

                  const gradients = [
                    "bg-gradient-to-br from-[#e0f2fe]/90 via-[#f0f9ff]/70 to-[#dcfce7]/80",
                    "bg-gradient-to-br from-[#ecfdf5]/90 via-[#f0fdf4]/70 to-[#fdf4ff]/80",
                    "bg-gradient-to-br from-[#faf5ff]/95 via-[#fdf4ff]/70 to-[#fff7ed]/80",
                    "bg-gradient-to-br from-[#fff7ed]/95 via-[#fffbeb]/70 to-[#e0f2fe]/80"
                  ];
                  const cardBg = gradients[(baseIndex + index) % gradients.length];

                  const card = document.createElement("a");
                  card.href = `/papers/${b.slug || b._id}`;
                  card.setAttribute("data-astro-prefetch", "viewport");
                  card.className = `paper-card ${cardBg} rounded-[28px] border border-neutral-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.06)] flex flex-col sm:flex-row overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.1)] cursor-pointer group`;

                  card.dataset.originalIndex = String(baseIndex + index);
                  card.dataset.timestamp = String(
                    b.publishedAt || b.createdAt
                      ? new Date(b.publishedAt || b.createdAt).getTime()
                      : 0,
                  );
                  card.dataset.views = String(b.views || 0);
                  card.dataset.readtime = String(readMinutes);
                  card.dataset.category = b.category || "";
                  card.dataset.doctype = docType;
                  card.dataset.authorId = String(authorId);
                  card.dataset.title = (b.title || "").toLowerCase();
                  card.dataset.author = (b.author?.name || "").toLowerCase();

                  const viewNum = Number(b.views) || 0;
                  const vLabel = viewNum >= 1000000 ? `${(viewNum/1000000).toFixed(1)}M+ views` : viewNum >= 1000 ? `${(viewNum/1000).toFixed(1)}k+ views` : `${viewNum} views`;

                  card.innerHTML = `
                    <div class="w-full sm:w-[220px] lg:w-[240px] h-[160px] sm:h-auto shrink-0 bg-neutral-900 relative overflow-hidden">
                      <img src="${thumb}" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    </div>
                    <div class="flex-1 p-4 sm:p-7 flex flex-col justify-between min-w-0">
                      <div class="flex flex-col gap-1.5">
                        <span class="inline-block px-3.5 py-1 bg-[#dbeafe] text-[#1d4ed8] rounded-full text-[11px] font-bold tracking-wider uppercase self-start shadow-sm">
                          ${b.category || "General"}
                        </span>
                        <h3 class="text-[16px] sm:text-[19px] font-extrabold text-[#0f172a] group-hover:text-[#1b62f2] leading-[1.35] tracking-tight mt-1 line-clamp-2 transition-colors">
                          ${b.title}
                        </h3>
                      </div>
                      <p class="text-[13px] sm:text-[14px] text-[#475569] leading-[1.5] line-clamp-2 my-2.5 font-normal">
                        ${finalExcerpt}
                      </p>
                      <div class="flex items-center gap-3 text-[12px] text-[#64748b] flex-wrap font-medium pt-2 border-t border-neutral-200/60">
                        <div class="flex items-center gap-2">
                          ${b.author?.avatar ? `<img src="${b.author.avatar}" alt="" class="w-6 h-6 rounded-full object-cover shadow-sm" />` : `<div class="w-6 h-6 rounded-full bg-neutral-300 flex items-center justify-center text-[11px] font-bold text-neutral-700 shadow-sm">${(b.author?.name || "R").charAt(0)}</div>`}
                          <span class="text-[#0f172a] font-bold">${b.author?.name || "Researcher"}</span>
                        </div>
                        <span>•</span>
                        <span>${pubDate}</span>
                        <span>•</span>
                        <span class="flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                          ${readMinutes} min read
                        </span>
                        <span>•</span>
                        <span class="flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                          ${vLabel}
                        </span>
                      </div>
                    </div>
                  `;

                  papersFeed?.appendChild(card);
                });

                applyFilters();
                applySort();
              }
            }
          } catch (err) {
            console.error("Pagination load error:", err);
          } finally {
            isLoading = false;
            if (loadMoreSpinner) loadMoreSpinner.classList.add("hidden");
            if (loadMoreText)
              loadMoreText.textContent = "Load More";

            if (!hasMore) {
              loadMoreBtn?.classList.remove("flex");
              loadMoreBtn?.classList.add("hidden");
              allLoadedMsg?.classList.remove("hidden");
              allLoadedMsg?.classList.add("block");
            }
          }
        }

        loadMoreBtn?.addEventListener("click", loadNextPage);

        const modalAreas = document.getElementById("modal-areas");
        const modalResearchers = document.getElementById("modal-researchers");
        const openAreasBtn = document.getElementById("open-areas-modal");
        const openResearchersBtn = document.getElementById(
          "open-researchers-modal",
        );
        const closeButtons = document.querySelectorAll(".close-modal");

        openAreasBtn?.addEventListener("click", () => {
          modalAreas?.classList.remove("hidden");
          modalAreas?.classList.add("flex");
        });

        openResearchersBtn?.addEventListener("click", () => {
          modalResearchers?.classList.remove("hidden");
          modalResearchers?.classList.add("flex");
        });

        closeButtons.forEach((b) => {
          b.addEventListener("click", () => {
            modalAreas?.classList.add("hidden");
            modalAreas?.classList.remove("flex");
            modalResearchers?.classList.add("hidden");
            modalResearchers?.classList.remove("flex");
          });
        });

        [modalAreas, modalResearchers].forEach((m) => {
          m?.addEventListener("click", (e) => {
            if (e.target === m) {
              m.classList.add("hidden");
              m.classList.remove("flex");
            }
          });
        });

        const urlParams = new URLSearchParams(window.location.search);
        const areaParam = urlParams.get("area");
        const typeParam = urlParams.get("type");
        if (typeParam === "BLOG" || typeParam === "blog") {
          setDocType("BLOG");
        } else {
          setDocType("RESEARCH");
        }
        if (areaParam) {
          setCategory(areaParam);
        }
      }

      document.addEventListener("astro:page-load", initDiscover);
    </script>
  </body>
</html>
