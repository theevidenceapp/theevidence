          </div>
        </div>

        <!-- COLUMN 2: Cards Feed & Dynamic Interactive Filter -->
        <main
          class="flex-1 h-full overflow-y-auto no-scroll pr-0.5 sm:pr-1 flex flex-col gap-4 relative"
        >
          <!-- SMOOTH LOADING OVERLAY FOR INSTANT TRANSITION FEEDBACK -->
