              data-filter="readtime"
              class="filter-tab px-5 h-[36px] flex items-center justify-center rounded-full text-[13px] font-medium transition-all whitespace-nowrap shrink-0 cursor-pointer bg-white text-[#1a1a1a] hover:bg-[#e8f0fe] hover:text-[#1b62f2] border border-neutral-200/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)]"
