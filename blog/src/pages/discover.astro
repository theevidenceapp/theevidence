    <!-- Client Script: Sorting, Category Filter & Pagination Logic -->
    <script>
      function initDiscover() {
        const backendUri = document.body.getAttribute("data-backend-uri") || "http://localhost:5000";
        let currentPage = Number(document.body.getAttribute("data-current-page")) || 1;
        let totalPages = Number(document.body.getAttribute("data-total-pages")) || 1;
        let hasMore = document.body.getAttribute("data-has-more") === "true";
        let isLoading = false;

        const filterTabs = document.querySelectorAll(".filter-tab");
        const papersFeed = document.getElementById("papers-feed");
        const globalSearch = document.getElementById("global-search-input") as HTMLInputElement;
        const areaButtons = document.querySelectorAll(".area-item, .mobile-area-item");
        const clearAreaBtn = document.getElementById("btn-clear-area-filter");
        const activeCategoryPill = document.getElementById("active-category-pill");
        const activeCategoryName = document.getElementById("active-category-name");
        const dismissPillBtn = document.getElementById("btn-dismiss-category-pill");
        const noPapersMsg = document.getElementById("no-papers-msg");
        const mobileAreaLabel = document.getElementById("mobile-area-btn-label");

        const loadMoreBtn = document.getElementById("btn-load-more");
        const loadMoreText = document.getElementById("load-more-text");
        const loadMoreSpinner = document.getElementById("load-more-spinner");
        const allLoadedMsg = document.getElementById("all-loaded-msg");

        let activeCategory = "";
        let currentSort = "all";

        // Filter and update visibility
        function applyFilters() {
          const query = globalSearch ? globalSearch.value.toLowerCase().trim() : "";
          const cards = document.querySelectorAll(".paper-card");
          let visibleCount = 0;

          cards.forEach((c) => {
            const card = c as HTMLElement;
            const title = card.dataset.title || "";
            const author = card.dataset.author || "";
            const category = card.dataset.category || "";
            const textContent = card.innerText.toLowerCase();

            const matchesSearch = !query || title.includes(query) || author.includes(query) || textContent.includes(query);
            const matchesCategory = !activeCategory || category.toLowerCase() === activeCategory.toLowerCase();

            if (matchesSearch && matchesCategory) {
              card.style.display = "flex";
              visibleCount++;
            } else {
              card.style.display = "none";
            }
          });

          if (noPapersMsg) {
            noPapersMsg.style.display = visibleCount === 0 ? "flex" : "none";
          }
        }

        // Apply dynamic sorting to cards
        function applySort() {
          if (!papersFeed) return;
          const cards = Array.from(papersFeed.querySelectorAll(".paper-card"));

          cards.sort((a, b) => {
            const cardA = a as HTMLElement;
            const cardB = b as HTMLElement;

            if (currentSort === "recent") {
              return Number(cardB.dataset.timestamp || 0) - Number(cardA.dataset.timestamp || 0);
            } else if (currentSort === "views") {
              return Number(cardB.dataset.views || 0) - Number(cardA.dataset.views || 0);
            } else if (currentSort === "readtime") {
              return Number(cardA.dataset.readtime || 0) - Number(cardB.dataset.readtime || 0);
            } else {
              return Number(cardA.dataset.originalIndex || 0) - Number(cardB.dataset.originalIndex || 0);
            }
          });

          cards.forEach((card) => papersFeed.appendChild(card));
        }

        // Category selection
        function setCategory(catName: string) {
          activeCategory = activeCategory === catName ? "" : catName;

          areaButtons.forEach((btn) => {
            const btnCat = btn.getAttribute("data-category");
            if (activeCategory && btnCat?.toLowerCase() === activeCategory.toLowerCase()) {
              btn.classList.add("bg-[#e8f0fe]", "text-[#1b62f2]", "border-[#1b62f2]");
            } else {
              btn.classList.remove("bg-[#e8f0fe]", "text-[#1b62f2]", "border-[#1b62f2]");
            }
          });

          if (activeCategory) {
            clearAreaBtn?.classList.remove("hidden");
            if (activeCategoryPill && activeCategoryName) {
              activeCategoryName.textContent = activeCategory;
              activeCategoryPill.classList.remove("hidden");
              activeCategoryPill.classList.add("flex");
            }
            if (mobileAreaLabel) mobileAreaLabel.textContent = activeCategory;
          } else {
            clearAreaBtn?.classList.add("hidden");
            activeCategoryPill?.classList.add("hidden");
            activeCategoryPill?.classList.remove("flex");
            if (mobileAreaLabel) mobileAreaLabel.textContent = "Explore Areas";
          }

          applyFilters();
        }

        areaButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const cat = btn.getAttribute("data-category") || "";
            setCategory(cat);

            const modalAreas = document.getElementById("modal-areas");
            modalAreas?.classList.add("hidden");
            modalAreas?.classList.remove("flex");
          });
        });

        clearAreaBtn?.addEventListener("click", () => setCategory(""));
        dismissPillBtn?.addEventListener("click", () => setCategory(""));

        // Sort Tabs
        filterTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            currentSort = tab.getAttribute("data-filter") || "all";

            filterTabs.forEach((t) => {
              t.classList.remove("bg-[#1b62f2]", "text-white", "shadow-[0_2px_8px_rgba(27,98,242,0.25)]", "border-transparent");
              t.classList.add("bg-white", "text-[#1a1a1a]", "hover:bg-[#e8f0fe]", "hover:text-[#1b62f2]", "border-neutral-200/60");
            });

            tab.classList.remove("bg-white", "text-[#1a1a1a]", "hover:bg-[#e8f0fe]", "hover:text-[#1b62f2]", "border-neutral-200/60");
            tab.classList.add("bg-[#1b62f2]", "text-white", "shadow-[0_2px_8px_rgba(27,98,242,0.25)]", "border-transparent");

            applySort();
          });
        });

        globalSearch?.addEventListener("input", applyFilters);

        // Sidebar search input
        const searchInput = document.getElementById("area-search-input") as HTMLInputElement;
        searchInput?.addEventListener("input", (e) => {
          const query = (e.target as HTMLInputElement).value.toLowerCase();
          document.querySelectorAll(".area-item").forEach((item) => {
            const textContent = item.textContent?.toLowerCase() || "";
            (item as HTMLElement).style.display = textContent.includes(query) ? "flex" : "none";
          });
        });

        // Load More Pagination Handler
        async function loadNextPage() {
          if (isLoading || !hasMore) return;
          isLoading = true;

          if (loadMoreSpinner) loadMoreSpinner.classList.remove("hidden");
          if (loadMoreText) loadMoreText.textContent = "Loading research...";

          try {
            const nextPage = currentPage + 1;
            const res = await fetch(`${backendUri}/blog/published?page=${nextPage}&limit=12`, {
              headers: { "Accept": "application/json" }
            });
            const data = await res.json();

            if (res.ok && data.success && Array.isArray(data.blogs)) {
              if (data.blogs.length === 0) {
                hasMore = false;
              } else {
                currentPage = nextPage;
                totalPages = data.pagination?.totalPages || totalPages;
                hasMore = data.pagination?.hasMore ?? (currentPage < totalPages);

                const baseIndex = (currentPage - 1) * 12;

                data.blogs.forEach((b: any, index: number) => {
                  const rawExcerpt = b.excerpt || "";
                  const readMinutes = Math.max(1, Math.ceil((rawExcerpt.length || 500) / 400));
                  const pubDate = b.publishedAt || b.createdAt
                    ? new Date(b.publishedAt || b.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                    : "Aug 20, 2026";
                  const thumb = b.coverImage?.url || "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=400&auto=format&fit=crop&q=80";

                  const card = document.createElement("a");
                  card.href = `/papers/${b.slug || b._id}`;
                  card.setAttribute("data-astro-prefetch", "viewport");
                  card.className = "paper-card bg-white rounded-[20px] sm:rounded-[24px] p-4 sm:p-6 border border-neutral-200/40 shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-3 sm:gap-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_16px_rgba(0,0,0,0.05)] cursor-pointer group";

                  card.dataset.originalIndex = String(baseIndex + index);
                  card.dataset.timestamp = String(b.publishedAt || b.createdAt ? new Date(b.publishedAt || b.createdAt).getTime() : 0);
                  card.dataset.views = String(b.views || 0);
                  card.dataset.readtime = String(readMinutes);
                  card.dataset.category = b.category || "";
                  card.dataset.title = (b.title || "").toLowerCase();
                  card.dataset.author = (b.author?.name || "").toLowerCase();

                  card.innerHTML = `
                    <div class="flex items-start gap-3.5 sm:gap-4">
                      <img src="${thumb}" alt="" loading="lazy" decoding="async" class="w-[60px] h-[60px] sm:w-[74px] sm:h-[74px] rounded-xl sm:rounded-2xl object-cover shrink-0 bg-[#0f172a] border border-neutral-100" />
                      <div class="flex flex-col pt-0.5 min-w-0">
                        <span class="text-[11px] sm:text-[12px] text-[#6b7280] font-normal leading-none truncate">${b.category || "International Relations"}</span>
                        <h3 class="text-[15px] sm:text-[17px] font-bold text-[#111] group-hover:text-[#1b62f2] leading-[1.3] sm:leading-[1.25] tracking-tight mt-1 sm:mt-1.5 line-clamp-2 transition-colors">
                          ${b.title}
                        </h3>
                      </div>
                    </div>
                    <p class="text-[12.5px] sm:text-[13.5px] text-[#222] leading-[1.45] line-clamp-3">
                      ${rawExcerpt || "No abstract provided for this paper."}
                    </p>
                    <div class="flex items-center gap-3 sm:gap-5 text-[11px] sm:text-[12px] text-[#6b7280] pt-1 flex-wrap font-normal">
                      <div class="flex items-center gap-1.5 text-[#4b5563]">
                        <div class="w-4 h-4 rounded-full bg-[#d8d8d8] overflow-hidden flex items-center justify-center shrink-0 text-[9px] font-bold text-neutral-600">
                          ${b.author?.avatar ? `<img src="${b.author.avatar}" alt="" class="w-full h-full object-cover" />` : (b.author?.name?.charAt(0) || "R")}
                        </div>
                        <span class="truncate max-w-[110px] sm:max-w-none font-medium text-neutral-800">${b.author?.name || "Researcher"}</span>
                      </div>
                      <div class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#888]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Published ${pubDate}</span>
                      </div>
                      <div class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#888]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span>${b.views || 0} views</span>
                      </div>
                      <span>${readMinutes} min read</span>
                    </div>
                  `;

                  papersFeed?.appendChild(card);
                });

                applyFilters();
                applySort();
              }
            }
          } catch (err) {
            console.error("Pagination load error:", err);
          } finally {
            isLoading = false;
            if (loadMoreSpinner) loadMoreSpinner.classList.add("hidden");
            if (loadMoreText) loadMoreText.textContent = "Load More Research Papers";

            if (!hasMore) {
              loadMoreBtn?.classList.remove("flex");
              loadMoreBtn?.classList.add("hidden");
              allLoadedMsg?.classList.remove("hidden");
              allLoadedMsg?.classList.add("block");
            }
          }
        }

        loadMoreBtn?.addEventListener("click", loadNextPage);

        // Mobile Sheet Modals
        const modalAreas = document.getElementById("modal-areas");
        const modalResearchers = document.getElementById("modal-researchers");
        const openAreasBtn = document.getElementById("open-areas-modal");
        const openResearchersBtn = document.getElementById("open-researchers-modal");
        const closeButtons = document.querySelectorAll(".close-modal");

        openAreasBtn?.addEventListener("click", () => {
          modalAreas?.classList.remove("hidden");
          modalAreas?.classList.add("flex");
        });

        openResearchersBtn?.addEventListener("click", () => {
          modalResearchers?.classList.remove("hidden");
          modalResearchers?.classList.add("flex");
        });

        closeButtons.forEach((b) => {
          b.addEventListener("click", () => {
            modalAreas?.classList.add("hidden");
            modalAreas?.classList.remove("flex");
            modalResearchers?.classList.add("hidden");
            modalResearchers?.classList.remove("flex");
          });
        });

        [modalAreas, modalResearchers].forEach((m) => {
          m?.addEventListener("click", (e) => {
            if (e.target === m) {
              m.classList.add("hidden");
              m.classList.remove("flex");
            }
          });
        });

        const urlParams = new URLSearchParams(window.location.search);
        const areaParam = urlParams.get("area");
        if (areaParam) {
          setCategory(areaParam);
        }
      }

      document.addEventListener("astro:page-load", initDiscover);
    </script>
  </body>
</html>