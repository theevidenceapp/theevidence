---
import { ClientRouter } from "astro:transitions";
import "../../styles/globals.css";

export const prerender = false;

const { slug } = Astro.params;
const THE_EVIDENCE_LOGO = "https://pub-d65f9d792dba44cfb4b36fdd1925ed72.r2.dev/theevidence.png";
const GLOBE_THUMB = "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=1200&auto=format&fit=crop&q=80";

const backendUri = import.meta.env.VITE_BACKEND_URI || import.meta.env.PUBLIC_BACKEND_URI || "http://localhost:5000";

let blog: any = null;

try {
  const res = await fetch(`${backendUri}/blog/get/${slug}`);
  if (res.ok) {
    const data = await res.json();
    if (data.success && data.blog) {
      blog = data.blog;
    }
  }
} catch (e) {
  console.error("Fetch error:", e);
}

// Fallback dummy article for preview
if (!blog) {
  blog = {
    _id: "demo-id",
    title: "The Future of Digital Diplomacy and Sovereign Cyber Governance",
    slug: slug || "digital-diplomacy",
    content: `
      <p>The global geopolitical paradigm is rapidly transitioning from territorial bilateral diplomacy to algorithmic, digital-first negotiations. Sovereign entities are now deploying automated strategic analysis engines to model treaty outcomes, monitor cross-border data telemetry, and enforce cyber security protocols.</p>

      <h2>1. The Shift to Algorithmic Multipolarity</h2>
      <p>State actors are investing heavily in localized data custody. Standardized cross-border information exchanges are required to preserve sovereign autonomy while preventing weaponized cyber interference in international communications.</p>

      <blockquote>"Algorithmic diplomacy does not replace human statecraft—it elevates the speed and complexity of sovereign decision-making."</blockquote>

      <h2>2. Key Structural Pillars</h2>
      <ul>
        <li><strong>Multilateral Treaty Simulation:</strong> High-speed policy extraction across multilingual draft treaty corpuses.</li>
        <li><strong>Cryptographic Provenance:</strong> Ensuring public policy communications carry immutable origin proofs.</li>
        <li><strong>Infrastructure Autonomy:</strong> Preserving national communication backbones in contested environments.</li>
      </ul>

      <h2>3. Policy Recommendations</h2>
      <p>Diplomatic academies must institutionalize algorithmic risk auditing, establish mutual cybersecurity verification matrices, and construct sovereign custody repositories for critical statecraft documents.</p>
    `,
    excerpt: "An examination of how emerging digital technologies and intelligence models are restructuring diplomatic statecraft, multilateral cooperation, and international security.",
    coverImage: { url: GLOBE_THUMB },
    pdfs: [
      {
        url: "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        originalName: "Digital_Diplomacy_Framework_2026.pdf",
        _id: "pdf-1"
      },
      {
        url: "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        originalName: "Sovereign_Cyber_Governance_Brief.pdf",
        _id: "pdf-2"
      }
    ],
    author: {
      name: "Dr. Sarah Mitchell",
      email: "sarah.mitchell@theevidence.org"
    },
    category: "International Relations",
    tags: ["Diplomacy", "AI", "Geopolitics", "Cyber Governance"],
    views: 1480,
    createdAt: new Date().toISOString()
  };
}

const formattedDate = blog.createdAt
  ? new Date(blog.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "Aug 20, 2026";

const readTimeMinutes = Math.max(1, Math.ceil((blog.content ? blog.content.replace(/<[^>]*>?/gm, '').length : 500) / 400));
---

<!doctype html>
<html lang="en" class="bg-[#fcfcfd]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <ClientRouter />
    <title>{blog.title} - The Evidence</title>
    
    <!-- Google Fonts for Reading Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style is:global>
      html, body {
        background-color: #fcfcfd !important;
      }
      .no-scroll::-webkit-scrollbar { display: none; }
      .no-scroll { -ms-overflow-style: none; scrollbar-width: none; }

      /* Editorial Article Prose */
      .blog-prose {
        font-family: 'Lora', Georgia, serif;
        font-size: 19px;
        line-height: 1.85;
        color: #27272a;
      }
      .blog-prose h1, .blog-prose h2, .blog-prose h3, .blog-prose h4 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        color: #09090b;
        letter-spacing: -0.02em;
      }
      .blog-prose h1 { font-size: 2.1rem; margin: 2.4rem 0 1rem; line-height: 1.25; }
      .blog-prose h2 { font-size: 1.6rem; margin: 2rem 0 0.8rem; line-height: 1.3; }
      .blog-prose h3 { font-size: 1.25rem; margin: 1.5rem 0 0.5rem; line-height: 1.4; }
      .blog-prose p { margin-bottom: 1.4rem; }
      .blog-prose ul { list-style-type: disc; padding-left: 1.75rem; margin-bottom: 1.4rem; }
      .blog-prose ol { list-style-type: decimal; padding-left: 1.75rem; margin-bottom: 1.4rem; }
      .blog-prose li { margin-bottom: 0.4rem; }
      .blog-prose blockquote {
        font-family: 'Plus Jakarta Sans', sans-serif;
        border-left: 3px solid #1b62f2;
        padding: 0.75rem 0 0.75rem 1.5rem;
        color: #1e3a8a;
        font-style: italic;
        font-weight: 500;
        font-size: 1.15rem;
        margin: 2rem 0;
      }
      .blog-prose a { color: #1b62f2; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
      .blog-prose pre {
        font-family: 'JetBrains Mono', monospace;
        background: #18181b;
        color: #fafafa;
        padding: 1.25rem;
        border-radius: 14px;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.88em;
      }
      .blog-prose code {
        font-family: 'JetBrains Mono', monospace;
        background: #f4f4f5;
        padding: 0.2rem 0.45rem;
        border-radius: 6px;
        font-size: 0.88em;
      }
    </style>
  </head>
  <body class="bg-[#fcfcfd] text-[#111] antialiased min-h-screen flex flex-col m-0 p-0 font-sans select-none relative">
    
    <!-- Top Sticky Header -->
    <header class="h-[64px] sm:h-[70px] px-4 sm:px-8 flex items-center justify-between shrink-0 z-30 bg-white/80 backdrop-blur-md border-b border-neutral-200/60 sticky top-0">
      <div class="flex items-center gap-3">
        <a
          href="/discover"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-neutral-100 hover:bg-neutral-200/70 text-neutral-700 hover:text-black text-xs font-semibold transition active:scale-95 cursor-pointer"
          title="Back to Discover"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Discover</span>
        </a>
        <span class="text-neutral-300 hidden sm:inline">|</span>
        <span class="text-xs font-bold text-[#1b62f2] uppercase tracking-wider truncate max-w-[140px] sm:max-w-xs">{blog.category}</span>
      </div>

      <a href="/" class="flex items-center" title="The Evidence">
        <img src={THE_EVIDENCE_LOGO} alt="The Evidence" class="h-7 sm:h-8 w-auto object-contain" />
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-share"
          class="px-3.5 h-[34px] flex items-center gap-1.5 rounded-full bg-neutral-100 hover:bg-neutral-200/70 text-xs font-semibold text-neutral-700 hover:text-black transition cursor-pointer active:scale-95"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span class="hidden sm:inline">Share</span>
        </button>
      </div>
    </header>

    <!-- Main Editorial Reader Canvas -->
    <main class="flex-1 w-full max-w-[760px] mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
      
      <!-- ARTICLE TITLE & METADATA -->
      <section class="flex flex-col gap-4">
        
        <div class="flex items-center gap-2 text-xs text-neutral-500 font-medium">
          <span class="font-bold text-[#1b62f2]">{blog.category}</span>
          <span>•</span>
          <span>{readTimeMinutes} min read</span>
          <span>•</span>
          <span>{formattedDate}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-[#09090b] leading-[1.25] tracking-tight">
          {blog.title}
        </h1>

        <!-- Author Banner -->
        <div class="flex items-center justify-between gap-4 pt-2 border-b border-neutral-100 pb-5">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-full bg-[#1b62f2] flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-sm">
              {blog.author?.name ? blog.author.name.charAt(0) : "R"}
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-sm font-bold text-neutral-900 truncate">{blog.author?.name || "Researcher"}</span>
              <span class="text-xs text-neutral-500 truncate">{blog.author?.email || "Verified Publisher"}</span>
            </div>
          </div>

          <span class="text-xs text-neutral-500 font-medium">{blog.views || 0} views</span>
        </div>

      </section>

      <!-- HERO COVER IMAGE -->
      {blog.coverImage?.url && (
        <div class="w-full h-[240px] sm:h-[380px] rounded-2xl overflow-hidden bg-neutral-100 shadow-sm">
          <img
            src={blog.coverImage.url}
            alt={blog.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- ABSTRACT CALLOUT -->
      {blog.excerpt && (
        <div class="p-5 sm:p-6 bg-blue-50/50 rounded-2xl border border-blue-100 text-neutral-700 text-base sm:text-lg leading-relaxed italic">
          "{blog.excerpt}"
        </div>
      )}

      <!-- ARTICLE BODY -->
      <article class="blog-prose pt-2">
        <div set:html={blog.content}></div>
      </article>

      <!-- ATTACHED RESEARCH DOCUMENTS (Clean Card Drawer) -->
      {blog.pdfs && blog.pdfs.length > 0 && (
        <section class="mt-4 pt-8 border-t border-neutral-200/70 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2zm-1 15v-4H8l4-5 4 5h-3v4h-2z" />
              </svg>
              <h3 class="text-sm font-bold text-neutral-900">Attached Research Documents ({blog.pdfs.length})</h3>
            </div>
            <span class="text-[11px] text-neutral-500">PDF Evidence</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {blog.pdfs.map((pdf: any, idx: number) => (
              <div class="p-4 bg-white rounded-2xl border border-neutral-200/80 shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col justify-between gap-3 transition hover:border-neutral-300">
                <div class="flex items-start gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="text-xs font-bold text-neutral-800 truncate" title={pdf.originalName}>
                      {pdf.originalName || `Evidence_Document_${idx + 1}.pdf`}
                    </span>
                    <span class="text-[11px] text-neutral-400">PDF Document</span>
                  </div>
                </div>

                <div class="flex items-center gap-2 pt-1 border-t border-neutral-100">
                  <button
                    type="button"
                    class="btn-preview-pdf flex-1 py-1.5 px-3 rounded-lg bg-neutral-100 hover:bg-neutral-200/70 text-neutral-700 text-xs font-semibold transition cursor-pointer text-center"
                    data-pdf-url={pdf.url}
                    data-pdf-name={pdf.originalName || `Document ${idx + 1}`}
                  >
                    Preview
                  </button>
                  <a
                    href={pdf.url}
                    target="_blank"
                    download
                    class="py-1.5 px-3 rounded-lg bg-[#1b62f2] hover:bg-[#1855d4] text-white text-xs font-semibold transition flex items-center justify-center gap-1 cursor-pointer"
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 002 3h12a3 3 0 002-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span>Download</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- TAGS & FOOTER -->
      <section class="flex flex-col gap-4 border-t border-neutral-200/70 pt-6">
        {blog.tags && blog.tags.length > 0 && (
          <div class="flex items-center gap-1.5 flex-wrap">
            {blog.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-neutral-100 text-neutral-700 rounded-full text-xs font-medium">
                #{tag.trim()}
              </span>
            ))}
          </div>
        )}

        <div class="flex items-center justify-between pt-2">
          <a
            href="/discover"
            class="text-xs font-semibold text-neutral-600 hover:text-[#1b62f2] transition flex items-center gap-1"
          >
            ← Back to all research papers
          </a>
        </div>
      </section>

    </main>

    <!-- FULL SCREEN PDF VIEWER MODAL -->
    <div id="pdf-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex-col justify-between">
      <div class="h-14 px-4 sm:px-6 bg-neutral-900 text-white flex items-center justify-between shrink-0 border-b border-neutral-800">
        <span id="modal-pdf-title" class="text-xs sm:text-sm font-semibold truncate max-w-xs sm:max-w-md">Document Preview</span>
        <div class="flex items-center gap-2">
          <a id="modal-download-btn" href="#" target="_blank" download class="px-3 py-1 bg-[#1b62f2] rounded-lg text-xs font-semibold text-white">
            Download
          </a>
          <button type="button" id="btn-close-modal" class="px-3 py-1 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-xs font-semibold cursor-pointer">
            Close ✕
          </button>
        </div>
      </div>
      <iframe id="modal-pdf-frame" class="flex-1 w-full h-full border-none bg-white"></iframe>
    </div>

    <!-- Interactive Client Scripts -->
    <script>
      function initPaperView() {
        const previewButtons = document.querySelectorAll(".btn-preview-pdf");
        const modal = document.getElementById("pdf-modal");
        const modalFrame = document.getElementById("modal-pdf-frame") as HTMLIFrameElement;
        const modalTitle = document.getElementById("modal-pdf-title");
        const modalDownload = document.getElementById("modal-download-btn") as HTMLAnchorElement;
        const closeModal = document.getElementById("btn-close-modal");
        const shareBtn = document.getElementById("btn-share");

        previewButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const url = btn.getAttribute("data-pdf-url") || "";
            const name = btn.getAttribute("data-pdf-name") || "Document.pdf";

            if (modal && modalFrame) {
              modalFrame.src = url;
              if (modalTitle) modalTitle.textContent = name;
              if (modalDownload) modalDownload.href = url;
              modal.classList.remove("hidden");
              modal.classList.add("flex");
            }
          });
        });

        closeModal?.addEventListener("click", () => {
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
          if (modalFrame) modalFrame.src = "";
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            if (modalFrame) modalFrame.src = "";
          }
        });

        // Share Action
        shareBtn?.addEventListener("click", () => {
          if (navigator.share) {
            navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } else {
            navigator.clipboard.writeText(window.location.href);
            alert("Article link copied to clipboard!");
          }
        });
      }

      document.addEventListener("astro:page-load", initPaperView);
      initPaperView();
    </script>
  </body>
</html>