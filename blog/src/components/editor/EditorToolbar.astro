---
---

<div
  id="format-dock"
  class="fixed z-50 flex flex-col items-center gap-2 select-none touch-none"
  style="left: 50%; bottom: 20px; transform: translateX(-50%);"
>
  <div class="bg-[#dcdfd8]/90 backdrop-blur-md px-4 py-1 rounded-full text-[11px] text-neutral-700 font-medium flex items-center gap-1.5 shadow-sm">
    <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
    </svg>
    <span id="autosave-label">The Evidence autosaves the work!</span>
  </div>

  <div class="bg-white/95 backdrop-blur-xl rounded-full px-3.5 sm:px-5 py-2 shadow-[0_8px_30px_rgba(0,0,0,0.14)] border border-neutral-200/80 flex items-center gap-1.5 sm:gap-3 relative max-w-[96vw] overflow-visible">
    
    <div id="dock-drag-handle" class="text-neutral-300 hover:text-neutral-500 cursor-grab active:cursor-grabbing pr-1 flex items-center touch-none">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/>
        <circle cx="9" cy="12" r="2"/><circle cx="15" cy="12" r="2"/>
        <circle cx="9" cy="18" r="2"/><circle cx="15" cy="18" r="2"/>
      </svg>
    </div>

    <button type="button" id="btn-dock-bold" class="text-sm font-bold text-neutral-800 hover:text-blue-600 px-2 py-1 cursor-pointer transition active:scale-90" title="Bold">
      B
    </button>

    <button type="button" id="btn-dock-underline" class="text-sm font-semibold underline text-neutral-800 hover:text-blue-600 px-2 py-1 cursor-pointer transition active:scale-90" title="Underline">
      <span class="underline underline-offset-4">U</span>
    </button>

    <button type="button" id="btn-dock-italic" class="text-sm italic font-serif text-neutral-800 hover:text-blue-600 px-2 py-1 cursor-pointer transition active:scale-90" title="Italic">
      I
    </button>

    <div class="w-px h-4 bg-neutral-200"></div>

    <button type="button" id="btn-dock-ol" class="text-xs font-semibold text-neutral-800 hover:text-blue-600 px-1.5 py-1 cursor-pointer transition active:scale-90" title="Numbered List">
      1.
    </button>

    <button type="button" id="btn-dock-ul" class="text-base leading-none font-bold text-neutral-800 hover:text-blue-600 px-1.5 py-1 cursor-pointer transition active:scale-90" title="Bullet List">
      •
    </button>

    <button type="button" id="btn-dock-quote" class="text-sm leading-none font-bold text-neutral-800 hover:text-blue-600 px-1.5 py-1 cursor-pointer transition active:scale-90" title="Blockquote">
      ❝
    </button>

    <button type="button" id="btn-dock-link-trigger" class="text-xs text-neutral-800 hover:text-blue-600 px-1.5 py-1 cursor-pointer transition active:scale-90" title="Add Link">
      🔗
    </button>

    <div class="w-px h-4 bg-neutral-200"></div>

    <div class="relative">
      <button
        type="button"
        id="btn-heading-popup-toggle"
        class="bg-[#dbe8fd] hover:bg-[#cbe0fd] text-[#1b62f2] px-3.5 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 transition cursor-pointer shrink-0"
      >
        <span id="active-heading-label">Heading 1</span>
        <span id="active-size-label" class="text-[11px] opacity-75 hidden sm:inline">24px</span>
        <svg id="heading-arrow" class="w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
      </button>

      <div
        id="heading-size-menu"
        class="hidden absolute bottom-[calc(100%+12px)] right-0 bg-white/95 backdrop-blur-xl rounded-3xl p-3 shadow-[0_10px_35px_rgba(0,0,0,0.18)] border border-neutral-200/90 flex flex-col gap-1 w-48 z-50"
      >
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="0" data-size="14px" data-label="Small">
          <span class="text-xs font-semibold text-neutral-800">Small</span>
          <span class="text-[11px] text-neutral-400">14px</span>
        </button>
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="0" data-size="16px" data-label="Body">
          <span class="text-xs font-semibold text-neutral-800">Body</span>
          <span class="text-[11px] text-neutral-400">16px</span>
        </button>
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="4" data-size="16px" data-label="Heading 4">
          <span class="text-xs font-bold text-neutral-900">Heading 4</span>
          <span class="text-[11px] text-neutral-400">16px</span>
        </button>
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="3" data-size="18px" data-label="Heading 3">
          <span class="text-xs font-bold text-neutral-900">Heading 3</span>
          <span class="text-[11px] text-neutral-400">18px</span>
        </button>
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="2" data-size="20px" data-label="Heading 2">
          <span class="text-xs font-bold text-neutral-900">Heading 2</span>
          <span class="text-[11px] text-neutral-400">20px</span>
        </button>
        <button type="button" class="size-opt-btn w-full px-3 py-2 rounded-2xl hover:bg-[#eef2fe] hover:text-[#1b62f2] flex items-center justify-between text-left transition cursor-pointer" data-level="1" data-size="24px" data-label="Heading 1">
          <span class="text-xs font-black text-neutral-900">Heading 1</span>
          <span class="text-[11px] text-neutral-400">24px</span>
        </button>
      </div>
    </div>
  </div>
</div>