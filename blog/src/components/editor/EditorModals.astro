---
---

<div id="graph-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl p-6 shadow-2xl border border-neutral-200/80 w-full max-w-md flex flex-col gap-4 animate-in fade-in zoom-in-95 duration-150">
    <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
      <div>
        <h3 class="font-extrabold text-sm text-neutral-900">Select Graph Style</h3>
        <p id="graph-file-label" class="text-[11px] text-neutral-400">Clicking will immediately render and insert your chart</p>
      </div>
      <button type="button" id="btn-close-graph-modal" class="text-neutral-400 hover:text-neutral-700 font-bold p-1">✕</button>
    </div>

    <div class="grid grid-cols-2 gap-3 py-2">
      <button type="button" class="graph-type-card p-4 rounded-2xl border border-neutral-200/90 bg-neutral-50 hover:bg-[#eff4ff] hover:border-[#1b62f2] flex flex-col items-center text-center gap-2 cursor-pointer transition hover:scale-105 active:scale-95 group" data-type="bar">
        <span class="text-2xl group-hover:scale-110 transition">📊</span>
        <span class="text-xs font-bold text-neutral-800 group-hover:text-[#1b62f2]">Bar Chart</span>
        <span class="text-[10px] text-neutral-500">Categorical metrics</span>
      </button>

      <button type="button" class="graph-type-card p-4 rounded-2xl border border-neutral-200/90 bg-neutral-50 hover:bg-[#eff4ff] hover:border-[#1b62f2] flex flex-col items-center text-center gap-2 cursor-pointer transition hover:scale-105 active:scale-95 group" data-type="line">
        <span class="text-2xl group-hover:scale-110 transition">📈</span>
        <span class="text-xs font-bold text-neutral-800 group-hover:text-[#1b62f2]">Line Trend</span>
        <span class="text-[10px] text-neutral-500">Continuous timeline</span>
      </button>

      <button type="button" class="graph-type-card p-4 rounded-2xl border border-neutral-200/90 bg-neutral-50 hover:bg-[#eff4ff] hover:border-[#1b62f2] flex flex-col items-center text-center gap-2 cursor-pointer transition hover:scale-105 active:scale-95 group" data-type="doughnut">
        <span class="text-2xl group-hover:scale-110 transition">🍩</span>
        <span class="text-xs font-bold text-neutral-800 group-hover:text-[#1b62f2]">Doughnut</span>
        <span class="text-[10px] text-neutral-500">Proportions & share</span>
      </button>

      <button type="button" class="graph-type-card p-4 rounded-2xl border border-neutral-200/90 bg-neutral-50 hover:bg-[#eff4ff] hover:border-[#1b62f2] flex flex-col items-center text-center gap-2 cursor-pointer transition hover:scale-105 active:scale-95 group" data-type="polarArea">
        <span class="text-2xl group-hover:scale-110 transition">🎯</span>
        <span class="text-xs font-bold text-neutral-800 group-hover:text-[#1b62f2]">Polar Area</span>
        <span class="text-[10px] text-neutral-500">Cyclical spread</span>
      </button>
    </div>

    <div class="flex justify-end pt-1">
      <button type="button" id="btn-cancel-graph" class="px-4 py-2 rounded-xl text-xs font-semibold text-neutral-600 hover:bg-neutral-100 transition">Cancel</button>
    </div>
  </div>
</div>

<div id="link-modal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl p-6 shadow-2xl border border-neutral-200/80 w-full max-w-md flex flex-col gap-4 animate-in fade-in zoom-in-95 duration-150">
    <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
      <h3 class="font-bold text-sm text-neutral-900 flex items-center gap-2">
        <span>🔗 Insert Hyperlink</span>
      </h3>
      <button type="button" id="btn-close-link-modal" class="text-neutral-400 hover:text-neutral-700 font-bold">✕</button>
    </div>
    
    <div class="flex flex-col gap-3">
      <div id="link-text-group" class="flex flex-col gap-1">
        <label for="link-text-input" class="text-xs font-semibold text-neutral-600">Display Text</label>
        <input type="text" id="link-text-input" placeholder="e.g. Read Research Paper" class="w-full px-4 py-2 rounded-xl bg-neutral-50 border border-neutral-200 text-sm outline-none focus:border-blue-500 focus:bg-white transition" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="link-url-input" class="text-xs font-semibold text-neutral-600">Web URL</label>
        <input type="url" id="link-url-input" placeholder="https://evidence.org" class="w-full px-4 py-2 rounded-xl bg-neutral-50 border border-neutral-200 text-sm outline-none focus:border-blue-500 focus:bg-white transition" />
      </div>
    </div>

    <div class="flex justify-end gap-2 pt-2">
      <button type="button" id="btn-cancel-link" class="px-4 py-2 rounded-xl text-xs font-semibold text-neutral-600 hover:bg-neutral-100 transition">Cancel</button>
      <button type="button" id="btn-confirm-link" class="px-5 py-2 rounded-xl text-xs font-bold bg-[#1b62f2] text-white hover:bg-blue-600 transition shadow-sm">Insert Link</button>
    </div>
  </div>
</div>

<div id="category-alert-modal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-[120] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl p-6 shadow-2xl border border-neutral-200/90 w-full max-w-sm flex flex-col items-center text-center gap-3 animate-in fade-in zoom-in-95 duration-150">
    <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-2xl">
      ⚠️
    </div>
    <div class="flex flex-col gap-1">
      <h3 class="font-extrabold text-base text-neutral-900">Select a Research Category</h3>
      <p class="text-xs text-neutral-500 leading-relaxed">Please assign a category to this paper from the top dropdown before saving or publishing.</p>
    </div>
    <button type="button" id="btn-resolve-category" class="w-full py-2.5 mt-2 bg-[#1b62f2] hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition shadow-sm cursor-pointer active:scale-95">
      Select Category Now
    </button>
  </div>
</div>

<div id="success-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-md z-[110] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl p-8 shadow-2xl border border-neutral-200/80 w-full max-w-sm flex flex-col items-center text-center gap-4 animate-in fade-in zoom-in-95 duration-200">
    <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl shadow-sm">
      ✓
    </div>
    <div class="flex flex-col gap-1">
      <h3 class="text-lg font-extrabold text-neutral-900">Blog Submitted & Published!</h3>
      <p class="text-xs text-neutral-500">Your research paper is live. Redirecting you to Discover...</p>
    </div>
    <button type="button" id="btn-go-discover" class="w-full py-3 bg-[#111] hover:bg-black text-white rounded-2xl text-xs font-bold transition shadow-md">
      Go to Discover Now
    </button>
  </div>
</div>