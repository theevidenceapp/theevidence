---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<header class="h-[64px] sm:h-[72px] px-4 sm:px-12 flex items-center justify-between shrink-0 z-30">
  <div class="flex items-center gap-3">
    <a
      href="/desk"
      class="w-8 h-8 rounded-full bg-white border border-neutral-200/80 shadow-sm flex items-center justify-center text-neutral-600 hover:text-black transition active:scale-95 cursor-pointer"
      title="Back to Desk"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </a>
    <div class="flex items-center gap-1.5 text-xs font-semibold text-neutral-500">
      <a href="/desk" class="hover:text-black transition">Desk</a>
      <span>/</span>
      <span class="text-neutral-900 font-bold">Editor</span>
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    <div class="relative">
      <button
        type="button"
        id="btn-category-toggle"
        class="px-3 sm:px-3.5 py-1.5 rounded-full bg-white border border-amber-300 shadow-sm text-xs font-semibold text-neutral-700 hover:text-[#1b62f2] flex items-center gap-1.5 transition cursor-pointer active:scale-95"
      >
        <span id="category-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span id="selected-category-label" class="max-w-[130px] sm:max-w-none truncate text-neutral-700 font-bold">Select Category *</span>
        <svg class="w-3 h-3 text-neutral-400 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <div
        id="category-menu"
        class="hidden absolute right-0 top-10 w-60 bg-white rounded-2xl p-2 shadow-2xl border border-neutral-200/90 flex-col gap-1 z-50 text-xs font-medium max-h-72 overflow-y-auto no-scroll"
      >
        <div class="px-3 py-1.5 text-[11px] font-bold text-neutral-400 uppercase tracking-wider">Choose Category</div>
        {categories.map((cat) => (
          <button
            type="button"
            class="category-option-btn w-full text-left px-3 py-2 rounded-xl hover:bg-[#e8f0fe] hover:text-[#1b62f2] text-neutral-700 transition font-medium cursor-pointer"
            data-cat={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div class="relative">
      <button
        type="button"
        id="btn-options-toggle"
        class="w-8 h-8 rounded-full bg-white border border-neutral-200/80 shadow-sm flex items-center justify-center text-neutral-700 hover:text-black transition cursor-pointer active:scale-95"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="5" cy="12" r="2" />
          <circle cx="12" cy="12" r="2" />
          <circle cx="19" cy="12" r="2" />
        </svg>
      </button>

      <div
        id="options-menu"
        class="hidden absolute right-0 top-10 w-48 bg-white rounded-2xl p-2 shadow-2xl border border-neutral-200/80 flex-col gap-1 z-50 text-xs font-medium"
      >
        <button type="button" id="menu-btn-publish" class="w-full text-left px-3 py-2 rounded-xl text-blue-600 hover:bg-blue-50 font-bold transition flex items-center gap-2 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
          <span>Publish Paper</span>
        </button>
        <button type="button" id="menu-btn-draft" class="w-full text-left px-3 py-2 rounded-xl hover:bg-neutral-100 transition cursor-pointer">
          Save Draft
        </button>
        <button type="button" id="menu-btn-clear" class="w-full text-left px-3 py-2 rounded-xl text-rose-600 hover:bg-rose-50 transition cursor-pointer">
          Clear Storage Draft
        </button>
      </div>
    </div>
  </div>
</header>