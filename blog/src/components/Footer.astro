---
// src/components/Footer.astro
---
<footer class="w-full max-w-5xl mx-auto px-4 sm:px-6 pb-8">
  <div class="bg-neutral-100/70 dark:bg-neutral-900/60 backdrop-blur-sm border border-neutral-200/60 dark:border-neutral-800 rounded-3xl p-8 sm:p-10 flex flex-col md:flex-row justify-between gap-8">
    
    <!-- Brand / Signature & Socials -->
    <div class="flex flex-col justify-between gap-6">
      <div>
        <span class="font-serif italic text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          The Evidence
        </span>
      </div>
      <div class="flex items-center gap-4 text-neutral-600 dark:text-neutral-400">
        <a href="mailto:contact@theevidence.com" class="hover:text-black dark:hover:text-white" aria-label="Email">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
        <a href="#" class="hover:text-black dark:hover:text-white" aria-label="X (Twitter)">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" class="hover:text-black dark:hover:text-white" aria-label="Instagram">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" class="hover:text-black dark:hover:text-white" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.77a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
        </a>
      </div>
    </div>

    <!-- Navigation Columns -->
    <div class="grid grid-cols-3 gap-8 sm:gap-14 text-xs">
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-100">Explore</h4>
        <ul class="mt-3 space-y-2 text-neutral-500 dark:text-neutral-400">
          <li><a href="/research" class="hover:text-black dark:hover:text-white">Research</a></li>
          <li><a href="/about" class="hover:text-black dark:hover:text-white">About</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-100">Participate</h4>
        <ul class="mt-3 space-y-2 text-neutral-500 dark:text-neutral-400">
          <li><a href="/login" class="hover:text-black dark:hover:text-white">Sign In</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-100">Information</h4>
        <ul class="mt-3 space-y-2 text-neutral-500 dark:text-neutral-400">
          <li><a href="/login" class="hover:text-black dark:hover:text-white">Sign In</a></li>
          <li><a href="/privacy" class="hover:text-black dark:hover:text-white">Privacy</a></li>
          <li><a href="/terms" class="hover:text-black dark:hover:text-white">Terms</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-6 text-center text-[10px] text-neutral-400 dark:text-neutral-500">
    © 2026 The Evidence
  </div>
</footer>