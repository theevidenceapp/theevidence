---
// src/components/EditorialProcess.astro
---
<section class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-20 flex flex-col items-center">
  <div class="text-center max-w-2xl">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
      Not everything gets published
    </h2>
    <p class="mt-3 text-sm sm:text-base text-neutral-500 dark:text-neutral-400">
      Every submission passes through an editorial decision before it becomes part of The Evidence.
    </p>
  </div>

  <!-- Step Diagram: Vertical on mobile, Horizontal on desktop -->
  <div class="mt-16 w-full flex flex-col md:flex-row items-center justify-between relative gap-10 md:gap-0">
    
    <!-- Step 1 -->
    <div class="flex flex-col items-center text-center flex-1 z-10 max-w-xs">
      <div class="w-14 h-14 rounded-full bg-blue-600 text-white flex items-center justify-center shadow-lg shadow-blue-500/20">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      </div>
      <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100 text-sm sm:text-base">
        Written by researchers
      </h3>
      <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
        Original research, ideas, and findings shared by researchers with something meaningful to contribute.
      </p>
    </div>

    <!-- Connector 1 -->
    <div class="hidden md:flex items-center flex-1 px-4">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
      <div class="flex-1 border-t-2 border-dotted border-neutral-300 dark:border-neutral-700"></div>
      <span class="w-2.5 h-2.5 rounded-full bg-amber-600"></span>
    </div>
    <!-- Mobile vertical connector -->
    <div class="flex md:hidden flex-col items-center my-[-16px]">
      <span class="w-2 h-2 rounded-full bg-blue-600"></span>
      <div class="h-10 border-l-2 border-dotted border-neutral-300 dark:border-neutral-700"></div>
      <span class="w-2 h-2 rounded-full bg-amber-600"></span>
    </div>

    <!-- Step 2 -->
    <div class="flex flex-col items-center text-center flex-1 z-10 max-w-xs">
      <div class="w-14 h-14 rounded-full bg-amber-600 text-white flex items-center justify-center shadow-lg shadow-amber-500/20">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
      </div>
      <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100 text-sm sm:text-base">
        Reviewed by editors
      </h3>
      <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
        Every submission is carefully reviewed by editors before it earns its place in the publication.
      </p>
    </div>

    <!-- Connector 2 -->
    <div class="hidden md:flex items-center flex-1 px-4">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-600"></span>
      <div class="flex-1 border-t-2 border-dotted border-neutral-300 dark:border-neutral-700"></div>
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
    </div>
    <!-- Mobile vertical connector -->
    <div class="flex md:hidden flex-col items-center my-[-16px]">
      <span class="w-2 h-2 rounded-full bg-amber-600"></span>
      <div class="h-10 border-l-2 border-dotted border-neutral-300 dark:border-neutral-700"></div>
      <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
    </div>

    <!-- Step 3 -->
    <div class="flex flex-col items-center text-center flex-1 z-10 max-w-xs">
      <div class="w-14 h-14 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg shadow-emerald-500/20">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      </div>
      <h3 class="mt-4 font-semibold text-neutral-900 dark:text-neutral-100 text-sm sm:text-base">
        Made for reading
      </h3>
      <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
        A quiet, typography-first experience designed to keep the research — not the interface — at the centre.
      </p>
    </div>

  </div>
</section>